From df834dd76410385ceb73b31da6950dae4c155ad4 Mon Sep 17 00:00:00 2001
From: QC3284 <2078725082@qq.com>
Date: Sat, 21 Nov 2026 14:23:10 +0800
Subject: [PATCH] serial: pl01x: support the ZTE ZX279128S UART register map

The ZX279128S UART is a PL011 lookalike, but it moves DR to 0x04, FR to
0x14, LCRH to 0x30 and CR to 0x34 and it has no error clear register.
The offsets match the vendor_zte table of mainline Linux; a dual-offset
probe on the A1 hardware printed through the ZTE offsets and stayed
silent through the standard ARM PL011 ones.

The A1 port described the port as "arm,pl011", so probe disabled the
UART through the wrong CR offset and then never enabled the real one:
the firmware ran, but the console stayed silent.

Add TYPE_PL011_ZTE, map "zte,zx29-uart" to it, and route the register
accesses used by putc/getc/init/setbrg through the ZTE offsets.
IBRD/FBRD keep their standard offsets and stay untouched while the DT
has no "clock" property (secondboot already set 115200 8N1); TXFF and
RXFE keep their standard FR bit positions.

Signed-off-by: QC3284 <2078725082@qq.com>
---
 arch/arm/dts/zx279128s-zte-zxhn-e2631.dts |   3 +-
 drivers/serial/serial_pl01x.c             | 131 +++++++++++++++++-----
 include/dm/platform_data/serial_pl01x.h   |   2 +
 3 files changed, 107 insertions(+), 29 deletions(-)

diff --git a/arch/arm/dts/zx279128s-zte-zxhn-e2631.dts b/arch/arm/dts/zx279128s-zte-zxhn-e2631.dts
index 98427892..b7c2d4b6 100644
--- a/arch/arm/dts/zx279128s-zte-zxhn-e2631.dts
+++ b/arch/arm/dts/zx279128s-zte-zxhn-e2631.dts
@@ -46,12 +46,13 @@
 	};
 
 	/*
+	 * "zte,zx29-uart" selects the ZTE register map in serial_pl01x.c.
 	 * No "clock" property on purpose: CFG_PL011_CLOCK is 0, so the
 	 * driver keeps secondboot's 115200 8N1 setup instead of dividing
 	 * an unknown clock rate.
 	 */
 	uart0: serial@94404000 {
-		compatible = "arm,pl011";
+		compatible = "zte,zx29-uart";
 		reg = <0x94404000 0x1000>;
 	};
 };
diff --git a/drivers/serial/serial_pl01x.c b/drivers/serial/serial_pl01x.c
index e6bf0c29..dad02750 100644
--- a/drivers/serial/serial_pl01x.c
+++ b/drivers/serial/serial_pl01x.c
@@ -27,6 +27,71 @@
 
 DECLARE_GLOBAL_DATA_PTR;
 
+/*
+ * The ZTE ZX279128S UART is a PL011 lookalike with a different register map:
+ * DR is at 0x04, FR at 0x14, LCRH at 0x30 and CR at 0x34 (the ARM PL011 uses
+ * 0x00, 0x18, 0x2c and 0x30) and it has no error clear register.  The TXFF
+ * (bit 5) and RXFE (bit 4) flag bits keep their standard positions; only
+ * BUSY/DSR/CTS/RI move.  The offsets match the vendor_zte table of mainline
+ * Linux (include/linux/amba/serial.h, ZX_UART011_*).
+ */
+#define ZX_UART_DR		0x04
+#define ZX_UART_FR		0x14
+#define ZX_UART_LCRH		0x30
+#define ZX_UART_CR		0x34
+
+static u32 pl01x_read_reg(struct pl01x_regs *regs, unsigned int offset)
+{
+	return readl((u32 *)((char *)regs + offset));
+}
+
+static void pl01x_write_reg(struct pl01x_regs *regs, unsigned int offset,
+			    u32 value)
+{
+	writel(value, (u32 *)((char *)regs + offset));
+}
+
+static u32 pl01x_read_fr(struct pl01x_regs *regs, enum pl01x_type type)
+{
+	if (type == TYPE_PL011_ZTE)
+		return pl01x_read_reg(regs, ZX_UART_FR);
+	return readl(&regs->fr);
+}
+
+static u32 pl01x_read_dr(struct pl01x_regs *regs, enum pl01x_type type)
+{
+	if (type == TYPE_PL011_ZTE)
+		return pl01x_read_reg(regs, ZX_UART_DR);
+	return readl(&regs->dr);
+}
+
+static void pl01x_write_dr(struct pl01x_regs *regs, enum pl01x_type type,
+			   u32 value)
+{
+	if (type == TYPE_PL011_ZTE)
+		pl01x_write_reg(regs, ZX_UART_DR, value);
+	else
+		writel(value, &regs->dr);
+}
+
+static void pl01x_write_lcrh(struct pl01x_regs *regs, enum pl01x_type type,
+			     u32 value)
+{
+	if (type == TYPE_PL011_ZTE)
+		pl01x_write_reg(regs, ZX_UART_LCRH, value);
+	else
+		writel(value, &regs->pl011_lcrh);
+}
+
+static void pl01x_write_cr(struct pl01x_regs *regs, enum pl01x_type type,
+			   u32 value)
+{
+	if (type == TYPE_PL011_ZTE)
+		pl01x_write_reg(regs, ZX_UART_CR, value);
+	else
+		writel(value, &regs->pl011_cr);
+}
+
 #if !CONFIG_IS_ENABLED(DM_SERIAL)
 static volatile unsigned char *const port[] = CFG_PL01x_PORTS;
 static enum pl01x_type pl01x_type __section(".data");
@@ -35,42 +100,43 @@ static struct pl01x_regs *base_regs __section(".data");
 
 #endif
 
-static int pl01x_putc(struct pl01x_regs *regs, char c)
+static int pl01x_putc(struct pl01x_regs *regs, enum pl01x_type type, char c)
 {
 	/* Wait until there is space in the FIFO */
-	if (readl(&regs->fr) & UART_PL01x_FR_TXFF)
+	if (pl01x_read_fr(regs, type) & UART_PL01x_FR_TXFF)
 		return -EAGAIN;
 
 	/* Send the character */
-	writel(c, &regs->dr);
+	pl01x_write_dr(regs, type, c);
 
 	return 0;
 }
 
-static int pl01x_getc(struct pl01x_regs *regs)
+static int pl01x_getc(struct pl01x_regs *regs, enum pl01x_type type)
 {
 	unsigned int data;
 
 	/* Wait until there is data in the FIFO */
-	if (readl(&regs->fr) & UART_PL01x_FR_RXFE)
+	if (pl01x_read_fr(regs, type) & UART_PL01x_FR_RXFE)
 		return -EAGAIN;
 
-	data = readl(&regs->dr);
+	data = pl01x_read_dr(regs, type);
 
 	/* Check for an error flag */
 	if (data & 0xFFFFFF00) {
-		/* Clear the error */
-		writel(0xFFFFFFFF, &regs->ecr);
+		/* Clear the error (the ZTE UART has no error clear register) */
+		if (type != TYPE_PL011_ZTE)
+			writel(0xFFFFFFFF, &regs->ecr);
 		return -1;
 	}
 
 	return (int) data;
 }
 
-static int pl01x_tstc(struct pl01x_regs *regs)
+static int pl01x_tstc(struct pl01x_regs *regs, enum pl01x_type type)
 {
 	schedule();
-	return !(readl(&regs->fr) & UART_PL01x_FR_RXFE);
+	return !(pl01x_read_fr(regs, type) & UART_PL01x_FR_RXFE);
 }
 
 static int pl01x_generic_serial_init(struct pl01x_regs *regs,
@@ -82,8 +148,9 @@ static int pl01x_generic_serial_init(struct pl01x_regs *regs,
 		writel(0, &regs->pl010_cr);
 		break;
 	case TYPE_PL011:
+	case TYPE_PL011_ZTE:
 		/* disable everything */
-		writel(0, &regs->pl011_cr);
+		pl01x_write_cr(regs, type, 0);
 		break;
 	default:
 		return -EINVAL;
@@ -92,7 +159,8 @@ static int pl01x_generic_serial_init(struct pl01x_regs *regs,
 	return 0;
 }
 
-static int pl011_set_line_control(struct pl01x_regs *regs)
+static int pl011_set_line_control(struct pl01x_regs *regs,
+				  enum pl01x_type type)
 {
 	unsigned int lcr;
 	/*
@@ -100,7 +168,7 @@ static int pl011_set_line_control(struct pl01x_regs *regs)
 	 * control register write
 	 */
 	lcr = UART_PL011_LCRH_WLEN_8 | UART_PL011_LCRH_FEN;
-	writel(lcr, &regs->pl011_lcrh);
+	pl01x_write_lcrh(regs, type, lcr);
 	return 0;
 }
 
@@ -147,7 +215,8 @@ static int pl01x_generic_setbrg(struct pl01x_regs *regs, enum pl01x_type type,
 		writel(UART_PL010_CR_UARTEN, &regs->pl010_cr);
 		break;
 	}
-	case TYPE_PL011: {
+	case TYPE_PL011:
+	case TYPE_PL011_ZTE: {
 		unsigned int temp;
 		unsigned int divider;
 		unsigned int remainder;
@@ -168,14 +237,16 @@ static int pl01x_generic_setbrg(struct pl01x_regs *regs, enum pl01x_type type,
 			temp = (8 * remainder) / baudrate;
 			fraction = (temp >> 1) + (temp & 1);
 
+			/* IBRD/FBRD have the same offset on the ZTE variant */
 			writel(divider, &regs->pl011_ibrd);
 			writel(fraction, &regs->pl011_fbrd);
 		}
 
-		pl011_set_line_control(regs);
+		pl011_set_line_control(regs, type);
 		/* Finally, enable the UART */
-		writel(UART_PL011_CR_UARTEN | UART_PL011_CR_TXE |
-		       UART_PL011_CR_RXE | UART_PL011_CR_RTS, &regs->pl011_cr);
+		pl01x_write_cr(regs, type, UART_PL011_CR_UARTEN |
+			       UART_PL011_CR_TXE | UART_PL011_CR_RXE |
+			       UART_PL011_CR_RTS);
 		break;
 	}
 	default:
@@ -215,15 +286,17 @@ int pl01x_serial_init(void)
 static void pl01x_serial_putc(const char c)
 {
 	if (c == '\n')
-		while (pl01x_putc(base_regs, '\r') == -EAGAIN);
+		while (pl01x_putc(base_regs, pl01x_type, '\r') == -EAGAIN)
+			;
 
-	while (pl01x_putc(base_regs, c) == -EAGAIN);
+	while (pl01x_putc(base_regs, pl01x_type, c) == -EAGAIN)
+		;
 }
 
 static int pl01x_serial_getc(void)
 {
 	while (1) {
-		int ch = pl01x_getc(base_regs);
+		int ch = pl01x_getc(base_regs, pl01x_type);
 
 		if (ch == -EAGAIN) {
 			schedule();
@@ -236,7 +309,7 @@ static int pl01x_serial_getc(void)
 
 static int pl01x_serial_tstc(void)
 {
-	return pl01x_tstc(base_regs);
+	return pl01x_tstc(base_regs, pl01x_type);
 }
 
 static void pl01x_serial_setbrg(void)
@@ -245,9 +318,9 @@ static void pl01x_serial_setbrg(void)
 	 * Flush FIFO and wait for non-busy before changing baudrate to avoid
 	 * crap in console
 	 */
-	while (!(readl(&base_regs->fr) & UART_PL01x_FR_TXFE))
+	while (!(pl01x_read_fr(base_regs, pl01x_type) & UART_PL01x_FR_TXFE))
 		schedule();
-	while (readl(&base_regs->fr) & UART_PL01x_FR_BUSY)
+	while (pl01x_read_fr(base_regs, pl01x_type) & UART_PL01x_FR_BUSY)
 		schedule();
 	pl01x_serial_init_baud(gd->baudrate);
 }
@@ -338,23 +411,23 @@ int pl01x_serial_getc(struct udevice *dev)
 {
 	struct pl01x_priv *priv = dev_get_priv(dev);
 
-	return pl01x_getc(priv->regs);
+	return pl01x_getc(priv->regs, priv->type);
 }
 
 int pl01x_serial_putc(struct udevice *dev, const char ch)
 {
 	struct pl01x_priv *priv = dev_get_priv(dev);
 
-	return pl01x_putc(priv->regs, ch);
+	return pl01x_putc(priv->regs, priv->type, ch);
 }
 
 int pl01x_serial_pending(struct udevice *dev, bool input)
 {
 	struct pl01x_priv *priv = dev_get_priv(dev);
-	unsigned int fr = readl(&priv->regs->fr);
+	unsigned int fr = pl01x_read_fr(priv->regs, priv->type);
 
 	if (input)
-		return pl01x_tstc(priv->regs);
+		return pl01x_tstc(priv->regs, priv->type);
 	else
 		return fr & UART_PL01x_FR_TXFE ? 0 : 1;
 }
@@ -370,6 +443,7 @@ static const struct dm_serial_ops pl01x_serial_ops = {
 #if CONFIG_IS_ENABLED(OF_REAL)
 static const struct udevice_id pl01x_serial_id[] ={
 	{.compatible = "arm,pl011", .data = TYPE_PL011},
+	{.compatible = "zte,zx29-uart", .data = TYPE_PL011_ZTE},
 	{.compatible = "arm,pl010", .data = TYPE_PL010},
 	{}
 };
@@ -456,7 +530,8 @@ static inline void _debug_uart_putc(int ch)
 {
 	struct pl01x_regs *regs = (struct pl01x_regs *)CONFIG_VAL(DEBUG_UART_BASE);
 
-	while (pl01x_putc(regs, ch) == -EAGAIN)
+	while (pl01x_putc(regs, IS_ENABLED(CONFIG_DEBUG_UART_PL011) ?
+			  TYPE_PL011 : TYPE_PL010, ch) == -EAGAIN)
 		;
 }
 
diff --git a/include/dm/platform_data/serial_pl01x.h b/include/dm/platform_data/serial_pl01x.h
index 811697ce..63f09f52 100644
--- a/include/dm/platform_data/serial_pl01x.h
+++ b/include/dm/platform_data/serial_pl01x.h
@@ -9,6 +9,8 @@
 enum pl01x_type {
 	TYPE_PL010,
 	TYPE_PL011,
+	/* PL011 lookalike with the ZTE ZX279128S register map */
+	TYPE_PL011_ZTE,
 };
 
 /*
-- 
2.56.1

