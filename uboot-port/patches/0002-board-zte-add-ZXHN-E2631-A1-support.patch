+++ b/board/zte/zxhn-e2631/zxhn-e2631.c
@@ -0,0 +1,22 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * ZTE ZXHN E2631 board (Sanechips ZX279128S)
+ *
+ * A1 RAM-chain port. The closed secondboot stage has already initialised
+ * DRAM, clocks and UART0, so the board code only has to hand the DRAM
+ * layout from the embedded device tree to U-Boot.
+ */
+
+#include <config.h>
+#include <fdtdec.h>
+#include <init.h>
+
+int dram_init(void)
+{
+	return fdtdec_setup_mem_size_base();
+}
+
+int dram_init_banksize(void)
+{
+	return fdtdec_setup_memory_banksize();
+}
