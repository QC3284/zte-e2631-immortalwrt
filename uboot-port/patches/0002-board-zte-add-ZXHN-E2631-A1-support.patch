diff --git a/include/configs/zx279128s_zte_zxhn-e2631.h b/include/configs/zx279128s_zte_zxhn-e2631.h
new file mode 100644
index 00000000..61767e81
--- /dev/null
+++ b/include/configs/zx279128s_zte_zxhn-e2631.h
@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Configuration for the ZTE ZXHN E2631 (Sanechips ZX279128S)
+ *
+ * The closed secondboot stage leaves DRAM, clocks and UART0 (115200 8N1)
+ * initialised. The A1 RAM-chain port therefore only needs the memory map
+ * and deliberately keeps caches off while the hand-off state is unknown.
+ */
+
+#ifndef __ZX279128S_ZTE_ZXHN_E2631_H
+#define __ZX279128S_ZTE_ZXHN_E2631_H
+
+/* 256 MiB DDR3 at 0x40000000, initialised by secondboot */
+#define CFG_SYS_SDRAM_BASE		0x40000000
+
+/*
+ * UART0 is a PL011 at 0x94404000. Its input clock is not known yet and
+ * secondboot has already programmed 115200 8N1, so do not reprogram the
+ * baud rate: a clock of 0 makes the PL011 driver skip the IBRD/FBRD setup.
+ */
+#define CFG_PL011_CLOCK			0
+
+/*
+ * Fallback rate of the A9 global timer if the DT clock lookup fails.
+ * a9_periph is CPU clock / 2, i.e. 500 MHz with the 1 GHz A9 cluster.
+ */
+#define CFG_SYS_HZ_CLOCK		500000000
+
+#endif /* __ZX279128S_ZTE_ZXHN_E2631_H */
