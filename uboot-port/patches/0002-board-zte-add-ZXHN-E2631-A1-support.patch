diff --git a/arch/arm/dts/zx279128s-zte-zxhn-e2631.dts b/arch/arm/dts/zx279128s-zte-zxhn-e2631.dts
new file mode 100644
index 00000000..98427892
--- /dev/null
+++ b/arch/arm/dts/zx279128s-zte-zxhn-e2631.dts
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * ZTE ZXHN E2631 (Sanechips ZX279128S), A1 RAM-chain device tree
+ *
+ * Only the pieces the A1 port uses are described: DRAM, the PL011 console
+ * and the Cortex-A9 global timer. SPI-NAND, Ethernet and CPU1 hand-off are
+ * intentionally left out until the A2 stage.
+ */
+
+/dts-v1/;
+
+/ {
+	model = "ZTE ZXHN E2631 (ZX279128S)";
+	compatible = "zte,zxhn-e2631", "zte,zx279128s";
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	aliases {
+		serial0 = &uart0;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	/* 256 MiB DDR3, initialised by secondboot */
+	memory@40000000 {
+		device_type = "memory";
+		reg = <0x40000000 0x10000000>;
+	};
+
+	/*
+	 * a9_periph runs at CPU clock / 2. The A9 cluster is clocked at
+	 * 1 GHz, so the global timer ticks at 500 MHz.
+	 */
+	a9_periph: clock-a9-periph {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <500000000>;
+	};
+
+	timer@800200 {
+		compatible = "arm,cortex-a9-global-timer";
+		reg = <0x800200 0x20>;
+		clocks = <&a9_periph>;
+	};
+
+	/*
+	 * No "clock" property on purpose: CFG_PL011_CLOCK is 0, so the
+	 * driver keeps secondboot's 115200 8N1 setup instead of dividing
+	 * an unknown clock rate.
+	 */
+	uart0: serial@94404000 {
+		compatible = "arm,pl011";
+		reg = <0x94404000 0x1000>;
+	};
+};
