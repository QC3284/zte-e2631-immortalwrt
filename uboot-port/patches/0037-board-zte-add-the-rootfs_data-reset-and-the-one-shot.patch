From e89838933d8352a308caef0f8c116e997c1b8f53 Mon Sep 17 00:00:00 2001
From: QC3284 <2078725082@qq.com>
Date: Sat, 28 Nov 2026 11:47:23 +0800
Subject: [PATCH 37/39] board: zte: add the rootfs_data reset and the one-shot
 slot request

The E4 v2 rescue page needs a factory reset that only erases the
overlay. Look rootfs_data up by name, check its offset and size against
the layout the page promises, then erase every good block and verify
that the result is blank. A missing or moved partition is refused
before anything is erased, so a different device tree cannot wipe an
unrelated region.

The page can also ask for one boot from a chosen slot. e2631boot reads
the RAM-only e2631_next_slot variable, accepts only 0 or 1, and only
when that slot carries a valid version header. The serial rule, the
class-1 fallback and the persistent environment stay untouched.

The U-Boot device tree describes rootfs_data as a fixed partition. Only
that one partition is declared: the bootloader addresses every other
region through absolute chip offsets and does not need partitions for
them.

Signed-off-by: QC3284 <2078725082@qq.com>
---
 arch/arm/dts/zx279128s-zte-zxhn-e2631.dts |  17 ++
 board/zte/zxhn-e2631/Makefile             |   1 +
 board/zte/zxhn-e2631/e2631boot.c          |  39 ++++
 board/zte/zxhn-e2631/e2631factory.c       | 269 ++++++++++++++++++++++
 board/zte/zxhn-e2631/e2631factory.h       |  46 ++++
 5 files changed, 372 insertions(+)
 create mode 100644 board/zte/zxhn-e2631/e2631factory.c
 create mode 100644 board/zte/zxhn-e2631/e2631factory.h

diff --git a/arch/arm/dts/zx279128s-zte-zxhn-e2631.dts b/arch/arm/dts/zx279128s-zte-zxhn-e2631.dts
index 7ed1deb5..8fb6b8f5 100644
--- a/arch/arm/dts/zx279128s-zte-zxhn-e2631.dts
+++ b/arch/arm/dts/zx279128s-zte-zxhn-e2631.dts
@@ -103,6 +103,23 @@
 			spi-max-frequency = <50000000>;
 			spi-rx-bus-width = <2>;
 			spi-tx-bus-width = <1>;
+
+			partitions {
+				compatible = "fixed-partitions";
+				#address-cells = <1>;
+				#size-cells = <1>;
+
+				/*
+				 * The kernel mounts this partition as the overlay
+				 * (rootfs_data). Only this one partition is described:
+				 * the bootloader addresses every other region through
+				 * absolute chip offsets and does not need partitions.
+				 */
+				partition@3360000 {
+					label = "rootfs_data";
+					reg = <0x03360000 0x004a0000>;
+				};
+			};
 		};
 	};
 };
