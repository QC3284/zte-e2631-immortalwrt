From 5cd5ff0c96042b2cb0d00c9af64222d9734591aa Mon Sep 17 00:00:00 2001
From: QC3284 <2078725082@qq.com>
Date: Sat, 21 Nov 2026 17:55:35 +0800
Subject: [PATCH 2/2] env: keep the location name when saveenv is disabled

env_load() prints the location driver name while it probes locations, and
env_select()/env_save() print it too, but ENV_NAME() only defined .name
when CONFIG_CMD_SAVEENV was set. A read-only configuration - such as the
ZXHN E2631 port, which loads the vendor MTD environment and compiles
saveenv out - therefore logged

    Loading Environment from <NULL>... OK

although the MTD location had loaded successfully. The C1a dry run read
that line as 'no environment location is active', so hide the name no
longer: one string per compiled environment driver is a fair price for a
log line that says which location was used.

Signed-off-by: QC3284 <2078725082@qq.com>
---
 include/env_internal.h | 12 +++++++-----
 1 file changed, 7 insertions(+), 5 deletions(-)

diff --git a/include/env_internal.h b/include/env_internal.h
index 0589c435..9eb38186 100644
--- a/include/env_internal.h
+++ b/include/env_internal.h
@@ -176,12 +176,14 @@ struct env_driver {
 #define U_BOOT_ENV_LOCATION(__name)					\
 	ll_entry_declare(struct env_driver, __name, env_driver)
 
-/* Declare the name of a location */
-#ifdef CONFIG_CMD_SAVEENV
+/*
+ * Declare the name of a location. env_load(), env_select() and env_save()
+ * print this name, so keep it even when saveenv is compiled out: a read-only
+ * location otherwise logs "Loading Environment from <NULL>... OK" and an
+ * active environment looks inactive. The cost is one string per compiled
+ * environment driver.
+ */
 #define ENV_NAME(_name) .name = _name,
-#else
-#define ENV_NAME(_name)
-#endif
 
 #ifdef CONFIG_CMD_SAVEENV
 #define env_save_ptr(x) x
