diff --git a/drivers/net/zx279128s_eth.c b/drivers/net/zx279128s_eth.c
index cda93c02..e27f6df2 100644
--- a/drivers/net/zx279128s_eth.c
+++ b/drivers/net/zx279128s_eth.c
@@ -18,7 +18,9 @@
  * into a ring that is not ready yet.
  */
 
+#include <command.h>
 #include <dm.h>
+#include <dm/device_compat.h>
 #include <linux/bitfield.h>
 #include <linux/bitops.h>
 #include <linux/byteorder/generic.h>
@@ -28,6 +30,7 @@
 #include <linux/iopoll.h>
 #include <linux/kernel.h>
 #include <memalign.h>
+#include <miiphy.h>
 #include <net.h>
 #include <phy.h>
 
@@ -375,3 +378,383 @@ static int zx_hw_init(void __iomem *base, const u8 *mac)
 
 	return 0;
 }
+
+/* ---- Packet path ------------------------------------------------------ */
+
+/*
+ * The buffer management unit hands out 2048-byte buffers by index.  A
+ * request that does not complete in time is left pending, exactly as the
+ * vendor driver does; U-Boot only sends a handful of frames, so a timeout
+ * is reported to the caller and the request is retried on the next frame.
+ */
+static int zx_bmu_alloc_bp(void __iomem *base)
+{
+	u32 val;
+	int ret;
+
+	val = readl(base + ZX_BMU_BUF_ALLOC);
+	writel(val | ZX_BMU_BUF_ALLOC_REQ, base + ZX_BMU_BUF_ALLOC);
+
+	ret = readl_poll_sleep_timeout(base + ZX_BMU_BUF_ALLOC, val,
+				       !(val & ZX_BMU_BUF_ALLOC_BUSY),
+				       ZX_TM_POLL_US, ZX_BMU_TIMEOUT_US);
+	if (ret)
+		return -ETIMEDOUT;
+
+	val = readl(base + ZX_BMU_BUF_ID);
+	if (!(val & ZX_BMU_BUF_ID_VALID))
+		return -ENOSPC;
+
+	return FIELD_GET(ZX_BMU_BUF_ID_BP, val);
+}
+
+static int zx_bmu_free_bp(void __iomem *base, u16 bp)
+{
+	u32 val;
+
+	if (readl_poll_sleep_timeout(base + ZX_BMU_FREE_STATUS, val,
+				     val & ZX_BMU_FREE_SLOTS,
+				     ZX_TM_POLL_US, ZX_BMU_FREE_TIMEOUT_US))
+		return -ETIMEDOUT;
+
+	writel(bp, base + ZX_BMU_BUF_FREE);
+	return 0;
+}
+
+/*
+ * Hand one consumed RX slot back to the traffic manager.  The traffic manager
+ * counts every frame against the class in descriptor byte 6 bit 0 and only
+ * returns slots of the class it names, so the class has to be preserved.
+ */
+static int zx_rx_release(void __iomem *base, int queue, int class)
+{
+	u32 val;
+	int ret;
+
+	ret = readl_poll_sleep_timeout(base + ZX_RX_REL_CTRL, val,
+				       !(val & ZX_RX_REL_BUSY),
+				       ZX_TM_POLL_US, ZX_RX_REL_TIMEOUT_US);
+	if (ret)
+		return ret;
+
+	writel(FIELD_PREP(ZX_RX_REL_COUNT, 1) |
+	       FIELD_PREP(ZX_RX_REL_CLASS, class) |
+	       FIELD_PREP(ZX_RX_REL_QUEUE, queue), base + ZX_RX_REL_DATA);
+	writel(ZX_RX_REL_BUSY, base + ZX_RX_REL_CTRL);
+	return 0;
+}
+
+struct zx279128s_eth_priv {
+	void __iomem *base;
+	u8 *arena;
+	int switch_port;
+	struct phy_device *phydev;
+	u16 tx_idx;
+	u32 rx_idx[ZX_RX_QUEUES];
+	u32 rx_bp;
+	u32 rx_class;
+	u32 rx_queue;
+	bool hw_ready;
+};
+
+static struct zx279128s_eth_priv *zx_debug_priv;
+
+/* The frame is sent from the fixed arena; caches are off, so no flush. */
+static int zx279128s_eth_send(struct udevice *dev, void *packet, int length)
+{
+	struct zx279128s_eth_priv *priv = dev_get_priv(dev);
+	u32 tx_ring = ZX_DMA_ARENA_ADDR + ZX_TX_OFFSET;
+	__le32 *desc;
+	u32 len, idx, done;
+	u8 *buf;
+	int bp, ret;
+
+	len = length < ETH_ZLEN ? ETH_ZLEN : length;
+	if (len > 1536)
+		return -EINVAL;
+
+	bp = zx_bmu_alloc_bp(priv->base);
+	if (bp < 0)
+		return -ENOSPC;
+
+	buf = priv->arena + bp * ZX_BUF_SIZE + 16;
+	memset(buf, 0, len);
+	memcpy(buf, packet, length);
+
+	/*
+	 * Directed egress to this port's traffic manager queue; the frame
+	 * leaves through the packet processor bridge (mode 2 TX).
+	 */
+	idx = priv->tx_idx % ZX_NUM_TX_DESC;
+	desc = (__le32 *)(tx_ring + idx * ZX_DESC_SIZE);
+	desc[0] = cpu_to_le32(0x80 | (ZX_PORT_TX_QUEUE(priv->switch_port) << 20));
+	desc[1] = cpu_to_le32(0x10000);
+	desc[2] = cpu_to_le32(0x21000000 | ((len & 0x3fff) << 9));
+	desc[3] = cpu_to_le32(0x3 | ((len & 0x3fff) << 2));
+	((u8 *)desc)[7] = (u8)((bp & 0x7f) << 1);
+	((u8 *)desc)[8] = (u8)(bp >> 7);
+
+	/* Publish the descriptor before the doorbell. */
+	mb();
+	writel(1, priv->base + ZX_DMA_TX_START);
+	priv->tx_idx++;
+
+	/* The completion counter clears itself when read. */
+	ret = readl_poll_sleep_timeout(priv->base + ZX_DMA_TX_DONE, done,
+				       done & 0xffff, 10, 100000);
+	if (ret) {
+		printf("zx279128s: TX completion timed out\n");
+		return ret;
+	}
+
+	return 0;
+}
+
+/*
+ * There is no interrupt handler: the RX queue count is polled.  Queue 0 is
+ * the one the switch puts CPU frames on.  The descriptor is cleared here,
+ * before its slot is released in free_pkt(), because with a full ring the
+ * hardware refills a slot as soon as it is released.
+ */
+static int zx279128s_eth_recv(struct udevice *dev, int flags, uchar **packetp)
+{
+	struct zx279128s_eth_priv *priv = dev_get_priv(dev);
+	u32 rx_ring = ZX_DMA_ARENA_ADDR + ZX_RX_OFFSET;
+	u32 avail = readl(priv->base + ZX_DMA_RX_QUEUE_CNT(0)) & 0xffff;
+	__le32 *desc;
+	u16 bp, len;
+	u8 *dp;
+	int class;
+
+	if (!avail)
+		return -EAGAIN;
+
+	desc = (__le32 *)(rx_ring + (priv->rx_idx[0] % ZX_NUM_RX_DESC) *
+			  ZX_DESC_SIZE);
+	/* Read the descriptor after the queue count announced a frame. */
+	mb();
+	dp = (u8 *)desc;
+	bp = (dp[7] >> 1) | ((u16)dp[8] << 7);
+	len = (le32_to_cpu(desc[3]) >> 2) & 0x3fff;
+	class = dp[6] & 1;
+	priv->rx_idx[0]++;
+
+	if (bp >= ZX_NUM_BUFFERS || len < ETH_HLEN || len > 1536) {
+		/* Empty or torn slot: consume it so the index stays in step. */
+		desc[0] = 0;
+		desc[1] = 0;
+		desc[2] = 0;
+		desc[3] = 0;
+		/* Clear the slot before the hardware can refill it. */
+		mb();
+		zx_rx_release(priv->base, 0, class);
+		if (bp && bp < ZX_NUM_BUFFERS)
+			zx_bmu_free_bp(priv->base, bp);
+		return -EAGAIN;
+	}
+
+	desc[0] = 0;
+	desc[1] = 0;
+	desc[2] = 0;
+	desc[3] = 0;
+
+	priv->rx_bp = bp;
+	priv->rx_class = class;
+	priv->rx_queue = 0;
+	*packetp = priv->arena + bp * ZX_BUF_SIZE + 16;
+
+	return len;
+}
+
+static int zx279128s_eth_free_pkt(struct udevice *dev, uchar *packet,
+				  int length)
+{
+	struct zx279128s_eth_priv *priv = dev_get_priv(dev);
+	int ret;
+
+	/* The payload is consumed; hand the slot back in order. */
+	mb();
+	ret = zx_rx_release(priv->base, priv->rx_queue, priv->rx_class);
+	if (ret)
+		return ret;
+
+	if (priv->rx_bp && priv->rx_bp < ZX_NUM_BUFFERS)
+		zx_bmu_free_bp(priv->base, priv->rx_bp);
+	priv->rx_bp = 0;
+
+	return 0;
+}
+
+static int zx279128s_eth_write_hwaddr(struct udevice *dev)
+{
+	struct eth_pdata *pdata = dev_get_plat(dev);
+	struct zx279128s_eth_priv *priv = dev_get_priv(dev);
+
+	if (!priv->hw_ready)
+		return 0;
+
+	zx_set_trap_mac(priv->base, pdata->enetaddr);
+	return 0;
+}
+
+static int zx279128s_eth_start(struct udevice *dev)
+{
+	struct eth_pdata *pdata = dev_get_plat(dev);
+	struct zx279128s_eth_priv *priv = dev_get_priv(dev);
+	struct phy_device *phydev;
+	int ret;
+
+	/* The CRM clocks and the SerDes lanes must be up before any register. */
+	e2631_net_refclk_init();
+
+	priv->hw_ready = false;
+	ret = zx_hw_init(priv->base, pdata->enetaddr);
+	if (ret)
+		return ret;
+	priv->hw_ready = true;
+	memset(priv->rx_idx, 0, sizeof(priv->rx_idx));
+	priv->tx_idx = 0;
+
+	phydev = dm_eth_phy_connect(dev);
+	if (!phydev) {
+		printf("zx279128s: no PHY for lan1\n");
+		return -ENODEV;
+	}
+
+	phydev->supported &= PHY_GBIT_FEATURES;
+	phydev->advertising = phydev->supported;
+	phy_config(phydev);
+
+	ret = phy_startup(phydev);
+	if (ret) {
+		printf("zx279128s: PHY startup failed (%d)\n", ret);
+		return ret;
+	}
+
+	if (!phydev->link) {
+		printf("zx279128s: no link on lan1 (PHY %d)\n", phydev->addr);
+		return -EREMOTEIO;
+	}
+
+	priv->phydev = phydev;
+	zx_mac_set_speed(priv->base, priv->switch_port, phydev->speed,
+			 phydev->duplex);
+	zx_mac_enable(priv->base, priv->switch_port, true);
+	zx_set_trap_mac(priv->base, pdata->enetaddr);
+	zx_dma_enable(priv->base, true);
+	writel(~0, priv->base + ZX_TM_INT_MASK);
+
+	printf("zx279128s: lan1 up, %d Mbit/s %s duplex, MAC %pM\n",
+	       phydev->speed, phydev->duplex ? "full" : "half",
+	       pdata->enetaddr);
+
+	return 0;
+}
+
+static void zx279128s_eth_stop(struct udevice *dev)
+{
+	struct zx279128s_eth_priv *priv = dev_get_priv(dev);
+
+	if (!priv->hw_ready)
+		return;
+
+	writel(~0, priv->base + ZX_TM_INT_MASK);
+	zx_dma_enable(priv->base, false);
+	zx_mac_enable(priv->base, priv->switch_port, false);
+	priv->hw_ready = false;
+}
+
+static int zx279128s_eth_probe(struct udevice *dev)
+{
+	struct zx279128s_eth_priv *priv = dev_get_priv(dev);
+	fdt_addr_t addr = dev_read_addr(dev);
+	u32 port;
+
+	if (addr == FDT_ADDR_T_NONE)
+		return -EINVAL;
+
+	priv->base = (void __iomem *)(uintptr_t)addr;
+	priv->arena = (u8 *)(uintptr_t)ZX_DMA_ARENA_ADDR;
+
+	port = dev_read_u32_default(dev, "zte,switch-port", 2);
+	if (port >= ZX_NUM_PORTS) {
+		dev_err(dev, "bad zte,switch-port %u\n", port);
+		return -EINVAL;
+	}
+	priv->switch_port = port;
+
+	/*
+	 * Register the MDIO bus during probe (it is passive until the first
+	 * transfer), so that the "mii" commands work before the first start.
+	 */
+	dm_mdio_probe_devices();
+
+	zx_debug_priv = priv;
+	return 0;
+}
+
+static const struct eth_ops zx279128s_eth_ops = {
+	.start = zx279128s_eth_start,
+	.send = zx279128s_eth_send,
+	.recv = zx279128s_eth_recv,
+	.free_pkt = zx279128s_eth_free_pkt,
+	.stop = zx279128s_eth_stop,
+	.write_hwaddr = zx279128s_eth_write_hwaddr,
+};
+
+static const struct udevice_id zx279128s_eth_ids[] = {
+	{ .compatible = "zte,zx279128s-gmac" },
+	{ }
+};
+
+U_BOOT_DRIVER(zx279128s_eth) = {
+	.name = "zx279128s_eth",
+	.id = UCLASS_ETH,
+	.of_match = zx279128s_eth_ids,
+	.probe = zx279128s_eth_probe,
+	.ops = &zx279128s_eth_ops,
+	.priv_auto = sizeof(struct zx279128s_eth_priv),
+	.plat_auto = sizeof(struct eth_pdata),
+};
+
+/* ---- Debug command ---------------------------------------------------- */
+
+static int do_e2631net(struct cmd_tbl *cmdtp, int flag, int argc,
+		       char *const argv[])
+{
+	struct zx279128s_eth_priv *priv = zx_debug_priv;
+	u32 mac_ctrl;
+	int i;
+
+	if (!priv) {
+		printf("e2631net: the Ethernet driver has not been probed\n");
+		return CMD_RET_FAILURE;
+	}
+
+	printf("e2631net: lan1 switch port %d, %s\n", priv->switch_port,
+	       priv->hw_ready ? "started" : "stopped");
+	if (priv->phydev)
+		printf("e2631net: PHY %d %s, %d Mbit/s %s duplex\n",
+		       priv->phydev->addr,
+		       priv->phydev->link ? "link up" : "no link",
+		       priv->phydev->speed,
+		       priv->phydev->duplex ? "full" : "half");
+
+	mac_ctrl = readl(priv->base + ZX_MAC_PORT(priv->switch_port) +
+			 ZX_MAC_CTRL);
+	printf("e2631net: MAC ctrl 0x%08x, TM int 0x%08x, BMU free 0x%08x, TX done %u\n",
+	       mac_ctrl, readl(priv->base + ZX_TM_INT_STATUS),
+	       readl(priv->base + ZX_BMU_FREE_STATUS),
+	       readl(priv->base + ZX_DMA_TX_DONE) & 0xffff);
+
+	printf("e2631net: RX queue counts");
+	for (i = 0; i < ZX_RX_QUEUES; i++)
+		printf(" %u", readl(priv->base + ZX_DMA_RX_QUEUE_CNT(i)) & 0xffff);
+	printf("\n");
+
+	return CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(e2631net, 1, 1, do_e2631net,
+	   "print the zx279128s Ethernet state",
+	   "");
