+ * (MDIO bus, PHY and GMAC).  The CPU1 hand-off is still left out.
  */
 
 /dts-v1/;
@@ -56,6 +56,35 @@
 		reg = <0x94404000 0x1000>;
 	};
 
+	/*
+	 * MDIO controller and the four integrated PHYs.  lan1 is PHY 12 on
+	 * switch port 2, which is the port U-Boot uses; the addresses are the
+	 * ones the kernel board file maps (phy10..phy13 -> phy@a..phy@d).
+	 */
+	mdio: mdio@9a101000 {
+		compatible = "zte,zx279128s-mdio";
+		reg = <0x9a101000 0x100>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		phy12: ethernet-phy@c {
+			reg = <12>;
+		};
+	};
+
+	/*
+	 * The GMAC block (switch, traffic manager, CPU DMA engine).  U-Boot
+	 * drives one port through the CPU path and does no hardware
+	 * forwarding; see uboot-port/e2-net-driver-design.md.
+	 */
+	ethernet@92000000 {
+		compatible = "zte,zx279128s-gmac";
+		reg = <0x92000000 0x400000>;
+		phy-handle = <&phy12>;
+		phy-mode = "internal";
+		zte,switch-port = <2>;
+	};
+
 	/*
 	 * SPI-NAND controller. secondboot already brought it up, U-Boot only
 	 * needs the PIO read path. There is deliberately no "clocks" property:
diff --git a/board/zte/zxhn-e2631/e2631flash.c b/board/zte/zxhn-e2631/e2631flash.c
index 67e11d36..bb19d287 100644
--- a/board/zte/zxhn-e2631/e2631flash.c
+++ b/board/zte/zxhn-e2631/e2631flash.c
@@ -34,6 +34,7 @@
 #include <linux/types.h>
 #include <malloc.h>
 #include <memalign.h>
+#include <linux/build_bug.h>
 #include <mtd.h>
 #include <stdio.h>
 #include <u-boot/crc.h>
@@ -65,6 +66,21 @@
 #define E2631_BOUNCE_MAX	0x100000UL
 #define E2631_FLASH_SRC_MAX	0x10000000UL
 
+/*
+ * The Ethernet driver (patch 0020) owns a fixed 16 MiB DMA arena: buffer
+ * pool, traffic manager tables and the descriptor rings live there, and the
+ * traffic manager writes into it while the network is up.  e2631flash must
+ * never stage an image into it, and e2631verify must never read it as if it
+ * were a downloaded image.
+ */
+#define E2631_NET_ARENA_ADDR	0x45000000UL
+#define E2631_NET_ARENA_LEN	0x1000000UL
+
+static_assert(E2631_BOUNCE_ADDR + E2631_BOUNCE_MAX <= E2631_NET_ARENA_ADDR,
+	      "the e2631flash bounce buffer must stay below the network DMA arena");
+static_assert(E2631_NET_ARENA_ADDR + E2631_NET_ARENA_LEN <= E2631_RAM_LIMIT,
+	      "the network DMA arena must end below the relocated U-Boot");
+
 static int e2631_mtd_get(struct mtd_info **mtdp)
 {
 	struct mtd_info *mtd;
@@ -91,6 +107,32 @@ static bool e2631_overlap(u64 a, u64 alen, u64 b, u64 blen)
 	return a < b + blen && b < a + alen;
 }
 
+/*
+ * Check a RAM address range used as an image source: inside usable DRAM,
+ * and clear of the Ethernet driver's DMA arena.  A TFTP download into the
+ * arena would be overwritten by the traffic manager as soon as the network
+ * is used, and reading it as an image would compare live ring data.
+ */
+static int e2631_check_ram_range(const char *tag, ulong src, ulong len)
+{
+	if (src < E2631_RAM_BASE || (u64)src + len > E2631_RAM_LIMIT) {
+		printf("%s: source 0x%08lx..0x%08llx is outside usable DRAM (0x%08lx..0x%08lx)\n",
+		       tag, src, (u64)src + len, E2631_RAM_BASE,
+		       E2631_RAM_LIMIT);
+		return -EINVAL;
+	}
+
+	if (e2631_overlap(src, len, E2631_NET_ARENA_ADDR,
+			  E2631_NET_ARENA_LEN)) {
+		printf("%s: source 0x%08lx..0x%08llx overlaps the network DMA arena (0x%08lx..0x%08lx)\n",
+		       tag, src, (u64)src + len, E2631_NET_ARENA_ADDR,
+		       E2631_NET_ARENA_ADDR + E2631_NET_ARENA_LEN);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
 static int e2631_read_region(struct mtd_info *mtd, u64 off, void *buf,
 			     size_t len)
 {
@@ -142,11 +184,11 @@ static int e2631_flash_check(struct mtd_info *mtd, ulong src, ulong off,
 			       src, len, (u64)mtd->size);
 			return -EINVAL;
 		}
-	} else if (src < E2631_RAM_BASE ||
-		   (u64)src + len > E2631_RAM_LIMIT) {
-		printf("e2631flash: source 0x%08lx..0x%08llx is outside usable DRAM (0x%08lx..0x%08lx)\n",
-		       src, (u64)src + len, E2631_RAM_BASE, E2631_RAM_LIMIT);
-		return -EINVAL;
+	} else {
+		int ret = e2631_check_ram_range("e2631flash", src, len);
+
+		if (ret)
+			return ret;
 	}
 	if (off % mtd->erasesize || len % mtd->erasesize) {
 		printf("e2631flash: range 0x%08lx+0x%lx is not 0x%x aligned\n",
@@ -386,12 +428,8 @@ static int do_e2631verify(struct cmd_tbl *cmdtp, int flag, int argc,
 		printf("e2631verify: invalid length 0x%lx\n", len);
 		return CMD_RET_USAGE;
 	}
-	if (!src || src < E2631_RAM_BASE ||
-	    (u64)src + len > E2631_RAM_LIMIT) {
-		printf("e2631verify: source 0x%08lx..0x%08llx is outside the usable DRAM window\n",
-		       src, (u64)src + len);
+	if (!src || e2631_check_ram_range("e2631verify", src, len))
 		return CMD_RET_FAILURE;
-	}
 
 	ret = e2631_mtd_get(&mtd);
 	if (ret)
diff --git a/board/zte/zxhn-e2631/e2631net.c b/board/zte/zxhn-e2631/e2631net.c
index ee21a080..b48cbda5 100644
--- a/board/zte/zxhn-e2631/e2631net.c
+++ b/board/zte/zxhn-e2631/e2631net.c
@@ -223,12 +223,21 @@ static void e2631_pinmux_gpio_init(void)
  * The vendor ref_clk_set(0) fractional PLL programming on 0x94000050/0x94000054.
  * Field layout is the one the kernel clock driver documents: FBDIV bits[17:6],
  * PD1 bits[5:3], PD2 bits[2:0], FRAC in the second register bits[23:0].
+ *
+ * The sequence drives the PLLs, the SerDes lanes and the pinmux, and it waits
+ * about 750 ms in total.  Both the kernel hand-off (e2631boot) and the
+ * Ethernet start call it, so it runs once per boot: a second call returns
+ * immediately and leaves the programmed registers untouched.
  */
 void e2631_net_refclk_init(void)
 {
+	static int refclk_done;
 	unsigned int i;
 	u32 val, frac, strap;
 
+	if (refclk_done)
+		return;
+
 	e2631_pinmux_gpio_init();
 
 	val = e2631_readl(E2631_TOP_CRM_PLL0);
@@ -295,6 +304,8 @@ void e2631_net_refclk_init(void)
 	val &= ~0x00300000;
 	val |= 0x00100000;
 	e2631_writel(val, E2631_TOP_CRM_CTRL0C);
+
+	refclk_done = 1;
 }
 
 static void e2631_refclk_dump(const char *tag)
