From 22a85aab4fe63694eae01988f4a4e7a88ad4bed2 Mon Sep 17 00:00:00 2001
From: QC3284 <2078725082@qq.com>
Date: Sat, 28 Nov 2026 01:48:17 +0800
Subject: [PATCH] board: zte: bring up the network clocks for a cold rescue

e2631rescue can be the first command after a cold flash boot, before
e2631boot has run.  In that state the network reference clocks and the
SerDes lanes are still off, the internal PHYs do not answer MDIO and
phy_startup() times out, so the rescue reports "no usable Ethernet
device" - a rescue that only works after another command has run.

Call e2631_net_refclk_init() from do_e2631rescue() before the network
stack and the Ethernet driver are started.  The helper is idempotent,
and both e2631boot and zx279128s_eth_start() call it as well, so the
RAM-chain flow is unchanged.

Signed-off-by: QC3284 <2078725082@qq.com>
---
 board/zte/zxhn-e2631/e2631rescue.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/board/zte/zxhn-e2631/e2631rescue.c b/board/zte/zxhn-e2631/e2631rescue.c
index 5632153e..7cb6afc0 100644
--- a/board/zte/zxhn-e2631/e2631rescue.c
+++ b/board/zte/zxhn-e2631/e2631rescue.c
@@ -51,6 +51,7 @@
 
 #include "e2631flash.h"
 #include "e2631http.h"
+#include "e2631net.h"
 
 /* Upload staging: see the memory map in uboot-port/README.md. */
 #define E2631_RESCUE_IMG_ADDR	0x46000000UL
@@ -926,6 +927,15 @@ static int do_e2631rescue(struct cmd_tbl *cmdtp, int flag, int argc,
 		return CMD_RET_FAILURE;
 	}
 
+	/*
+	 * A command started from a cold flash prompt has not run e2631boot
+	 * yet, so the network reference clocks and the SerDes lanes are still
+	 * off: the internal PHYs then do not answer MDIO and phy_startup()
+	 * times out.  The helper is idempotent; e2631boot and the Ethernet
+	 * driver start path call it as well.
+	 */
+	e2631_net_refclk_init();
+
 	memset(&rescue_status, 0, sizeof(rescue_status));
 	rescue_status.stage = RESCUE_IDLE;
 	snprintf(rescue_status.sha_state, sizeof(rescue_status.sha_state),
-- 
