diff --git a/board/zte/zxhn-e2631/e2631env_tweak.h b/board/zte/zxhn-e2631/e2631env_tweak.h
new file mode 100644
index 00000000..e1a2a643
--- /dev/null
+++ b/board/zte/zxhn-e2631/e2631env_tweak.h
@@ -0,0 +1,89 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Stable save/restore records for the environment baseline alignment
+ * (task-98).
+ *
+ * e2631_env_align_with_baseline() temporarily replaces the non-whitelisted
+ * RAM variables with their flash baseline values so the exported candidate
+ * does not carry runtime keys. The values it saves used to be referenced
+ * through pointers into the first export buffer, which the second export
+ * overwrote: the restore then called env_set() with garbage key names
+ * ("illegal character '=' in variable name", "Error inserting baudrate").
+ * Every record now owns a copy of the key, so a restore can never depend on
+ * a buffer that has since been rewritten.
+ *
+ * The header is standalone (no U-Boot includes) so the host fixture can pin
+ * the lifetime rule.
+ *
+ * Copyright (C) 2026 QC3284
+ */
+
+#ifndef __BOARD_ZTE_E2631_ENV_TWEAK_H__
+#define __BOARD_ZTE_E2631_ENV_TWEAK_H__
+
+#include <stdbool.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define E2631_ENV_TWEAK_KEY_MAX		32
+
+struct e2631_env_tweak {
+	char key[E2631_ENV_TWEAK_KEY_MAX];
+	char *saved;
+	bool existed;
+};
+
+/*
+ * Record the current value of key (through get) and return a pointer to the
+ * record, which the caller fills before calling e2631_env_tweak_restore().
+ * Returns NULL when there is no room or no memory; the caller then aborts
+ * and restores the records it already has.
+ */
+static inline struct e2631_env_tweak *
+e2631_env_tweak_save(struct e2631_env_tweak *tweaks, int *count, int max,
+		     const char *key, const char *(*get)(const char *))
+{
+	struct e2631_env_tweak *tweak;
+	const char *cur;
+	size_t len;
+
+	if (!tweaks || !count || !key || !get)
+		return NULL;
+	if (*count >= max || strlen(key) >= E2631_ENV_TWEAK_KEY_MAX)
+		return NULL;
+
+	tweak = &tweaks[*count];
+	memset(tweak, 0, sizeof(*tweak));
+	strcpy(tweak->key, key);
+
+	cur = get(key);
+	tweak->existed = cur ? true : false;
+	if (cur) {
+		len = strlen(cur) + 1;
+		tweak->saved = malloc(len);
+		if (!tweak->saved)
+			return NULL;
+		memcpy(tweak->saved, cur, len);
+	}
+
+	(*count)++;
+	return tweak;
+}
+
+/* Restore every recorded variable and free the records and the key copies. */
+static inline void
+e2631_env_tweak_restore(struct e2631_env_tweak *tweaks, int count,
+			int (*set)(const char *key, const char *value))
+{
+	while (count-- > 0) {
+		struct e2631_env_tweak *tweak = &tweaks[count];
+
+		if (set)
+			set(tweak->key, tweak->existed ? tweak->saved : NULL);
+		free(tweak->saved);
+		tweak->saved = NULL;
+		tweak->key[0] = 0;
+	}
+}
+
+#endif /* __BOARD_ZTE_E2631_ENV_TWEAK_H__ */
