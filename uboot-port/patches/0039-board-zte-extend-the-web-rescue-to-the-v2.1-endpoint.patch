+static void rescue_slot_fields(char **p, size_t *left, int idx,
+			       const struct e2631_slot_info *si)
+{
+	unsigned long base = idx ? E2631_SLOT1_BASE : E2631_SLOT0_BASE;
+	char ver[40];
+
+	rescue_value(ver, sizeof(ver), si->version);
+	rescue_fmt(p, left, "slot%d_valid=%d\n", idx, si->valid);
+	rescue_fmt(p, left, "slot%d_intact=%d\n", idx, si->intact);
+	rescue_fmt(p, left, "slot%d_identity=%s\n", idx,
+		   e2631_slotcore_identity_name(si->identity));
+	rescue_fmt(p, left, "slot%d_serial=%u\n", idx, si->serial);
+	rescue_fmt(p, left, "slot%d_version=%s\n", idx, ver);
+	rescue_fmt(p, left, "slot%d_header_at=0x%08lx\n", idx,
+		   si->hpos >= 0 ? base + (unsigned long)si->hpos : 0UL);
+}
