+static void rescue_handle_console(struct e2631_rescue_conn *c, const char *query)
+{
+	static const char *const bad_body =
+		"result=error\nexit=1\nstdout=\ntruncated=0\n"
+		"error=only a single command is allowed\n";
+	char raw_cmd[257] = "";
+	char cmd[257];
+	char *raw = NULL, *esc = NULL;
+	bool truncated = false, overflowed = false;
+	int code;
+
+	if (!query) {
+		rescue_reply(c, 400, "Bad Request", "text/plain", NULL, bad_body,
+			     strlen(bad_body));
+		return;
+	}
+	rescue_query_value(query, "cmd=", raw_cmd, sizeof(raw_cmd));
+	if (!raw_cmd[0] || strlen(raw_cmd) > 256 ||
+	    rescue_has_nul_escape(raw_cmd)) {
+		rescue_reply(c, 400, "Bad Request", "text/plain", NULL, bad_body,
+			     strlen(bad_body));
+		return;
+	}
+	snprintf(cmd, sizeof(cmd), "%s", raw_cmd);
+	rescue_url_decode(cmd);
+	if (strpbrk(cmd, ";\r\n")) {
+		rescue_reply(c, 400, "Bad Request", "text/plain", NULL, bad_body,
+			     strlen(bad_body));
+		return;
+	}
+
+	raw = malloc(4096);
+	esc = malloc(16384);
+	if (!raw || !esc) {
+		free(raw);
+		free(esc);
+		rescue_error_reply(c, "out of memory");
+		return;
+	}
+
+	printf("e2631rescue: console command \"%s\"\n", cmd);
+	code = rescue_console_run(cmd, raw, 4096, &truncated, &overflowed);
+	if (code < 0) {
+		free(raw);
+		free(esc);
+		rescue_console_reply(c, 500, "error", 1, "", false,
+				     "console capture is not available");
+		return;
+	}
+	rescue_console_escape(raw, esc, 16384, &truncated);
+	rescue_console_reply(c, 200, "ok", code, esc, truncated || overflowed,
+			     "");
+	free(raw);
+	free(esc);
