+static void rescue_handle_boot(struct e2631_rescue_conn *c, const char *query)
+{
+	const struct e2631_slots *slots = rescue_slots();
+	char slot[8] = "";
+	char body[80];
+	int want;
+
+	if (!query || !rescue_query_value(query, "slot=", slot, sizeof(slot)))
+		goto bad;
+	rescue_url_decode(slot);
+	if (strcmp(slot, "0") && strcmp(slot, "1"))
+		goto bad;
+	want = slot[0] - '0';
+	if (!slots->slot[want].valid || !slots->slot[want].intact) {
+		rescue_error_reply(c, "slot is not bootable");
+		return;
+	}
+
+	env_set("e2631_next_slot", slot);
+	snprintf(body, sizeof(body), "result=ok\nnext_slot=%d\n", want);
+	printf("e2631rescue: next boot requested from slot%d\n", want);
+	rescue_reply(c, 200, "OK", "text/plain", NULL, body, strlen(body));
+	return;
+
+bad:
+	rescue_error_reply(c, "bad slot");
+}
