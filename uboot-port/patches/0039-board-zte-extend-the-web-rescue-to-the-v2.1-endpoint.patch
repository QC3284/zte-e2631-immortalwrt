+static void rescue_handle_factory(struct e2631_rescue_conn *c,
+				  const char *query, const char *hdr)
+{
+	char confirm[16] = "";
+	char err[96];
+	int ret;
+
+	if (query)
+		rescue_query_value(query, "confirm=", confirm, sizeof(confirm));
+	rescue_url_decode(confirm);
+	if (strcmp(confirm, "reset") ||
+	    !rescue_header_value(hdr, "X-E2631-Confirm", c->confirm_header,
+				 sizeof(c->confirm_header)) ||
+	    strcmp(c->confirm_header, "reset")) {
+		rescue_error_reply(c, "missing confirm");
+		return;
+	}
+	if (rescue_task_busy()) {
+		rescue_busy_reply(c);
+		return;
+	}
+
+	ret = e2631_factory_begin(err, sizeof(err));
+	if (ret) {
+		rescue_error_reply(c, err);
+		return;
+	}
+	factory_pending = true;
+	factory_finished = false;
+	factory_next_ms = get_timer(0) + E2631_RESCUE_DWELL_MS;
+	rescue_status.op = RESCUE_OP_FACTORY;
+	rescue_status.progress = 0;
+	rescue_status.error[0] = 0;
+	printf("e2631rescue: factory reset accepted\n");
+	rescue_reply(c, 200, "OK", "text/plain", NULL,
+		     "result=accepted\n", strlen("result=accepted\n"));
+}
+
+static bool rescue_env_key_writable(const char *key)
+{
+	size_t i;
+
+	if (!key[0] || strlen(key) > 32)
+		return false;
+	for (i = 0; key[i]; i++) {
+		if (!((key[i] >= 'a' && key[i] <= 'z') ||
+		      (key[i] >= '0' && key[i] <= '9') || key[i] == '_'))
+			return false;
+	}
+
+	return !strcmp(key, "bootdelay") || !strncmp(key, "e2631_", 6);
+}
+
+static bool rescue_env_value_ok(const char *value)
+{
+	size_t i;
+
+	if (strlen(value) > 128)
+		return false;
+	for (i = 0; value[i]; i++) {
+		if (value[i] < 0x20 || value[i] > 0x7e)
+			return false;
+	}
+
+	return true;
+}
