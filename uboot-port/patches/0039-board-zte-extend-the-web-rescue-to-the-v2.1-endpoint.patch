+/*
+ * Slot headers are cheap; the body CRCs behind "intact" are not (two 22 MiB
+ * spans).  Verify once while idle, then reuse the result until a writer
+ * invalidates it.
+ */
+static const struct e2631_slots *rescue_slots(void)
+{
+	if (!slots_ready && !e2631_fwslot_job_open()) {
+		e2631_fwslot_refresh(true);
+		slots_ready = true;
+	}
+
+	return e2631_fwslot_slots();
+}
