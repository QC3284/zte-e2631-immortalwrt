+static void rescue_body_bytes(struct e2631_rescue_conn *c, const u8 *data,
+			      u32 len)
+{
+	u32 space, base;
+
+	if (c->body_len >= c->content_len)
+		return;
+
+	if (c->upload_kind == UPLOAD_FIRMWARE) {
+		base = E2631_FW_STAGE_ADDR;
+		space = E2631_FW_STAGE_MAX - c->body_len;
+	} else {
+		base = E2631_RESCUE_IMG_ADDR;
+		space = E2631_RESCUE_IMG_LEN - c->body_len;
+	}
+
+	if (len > space)
+		len = space;
+
+	if (len) {
+		memcpy((void *)(uintptr_t)(base + c->body_len), data, len);
+		c->body_len += len;
+	}
+
+	if (c->body_len < c->content_len)
+		return;
+
+	if (c->upload_kind == UPLOAD_FIRMWARE)
+		rescue_firmware_body_complete(c);
+	else
+		rescue_flash_body_complete(c);
+}
