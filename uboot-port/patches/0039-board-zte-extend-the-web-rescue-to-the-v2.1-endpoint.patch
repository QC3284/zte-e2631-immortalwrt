+/* Send the next 16 KiB block; DATA_SENT drives the whole stream. */
+static int rescue_backup_block(struct e2631_rescue_conn *c)
+{
+	u32 n = c->backup_total - c->backup_sent;
+
+	if (!n)
+		return 0;
+	if (n > E2631_BACKUP_BLOCK)
+		n = E2631_BACKUP_BLOCK;
+	if (rescue_mtd_read(c->backup_off + c->backup_sent, c->backup_buf, n))
+		return -EIO;
+	if (mtk_tcp_send_data(c->conn, c->backup_buf, n))
+		return -EIO;
+	c->backup_sent += n;
+
+	return 0;
+}
+
+static void rescue_backup_start(struct e2631_rescue_conn *c, const char *query)
+{
+	sha256_context ctx;
+	u8 digest[SHA256_SUM_LEN];
+	char sha[SHA256_SUM_LEN * 2 + 1];
+	char part[16] = "bootloader";
+	u32 off, len, crc = 0, done = 0;
+	u8 *buf;
+	int n;
+
+	if (query)
+		rescue_query_value(query, "part=", part, sizeof(part));
+	rescue_url_decode(part);
+
+	if (rescue_backup_part(part, &off, &len)) {
+		rescue_error_reply(c, "bad part");
+		return;
+	}
+	if (backup_active) {
+		rescue_busy_reply(c);
+		return;
+	}
+
+	buf = malloc(E2631_BACKUP_BLOCK);
+	if (!buf) {
+		rescue_error_reply(c, "out of memory");
+		return;
+	}
+
+	sha256_starts(&ctx);
+	while (done < len) {
+		u32 n2 = len - done;
+
+		if (n2 > E2631_BACKUP_BLOCK)
+			n2 = E2631_BACKUP_BLOCK;
+		if (rescue_mtd_read(off + done, buf, n2))
+			break;
+		crc = crc32(crc, buf, n2);
+		sha256_update(&ctx, buf, n2);
+		done += n2;
+	}
+	if (done != len) {
+		free(buf);
+		rescue_error_reply(c, "flash read failed");
+		return;
+	}
+	sha256_finish(&ctx, digest);
+	rescue_hex(digest, sha);
+
+	n = snprintf((char *)c->out, sizeof(c->out),
+		     "HTTP/1.1 200 OK\r\n"
+		     "Server: e2631rescue\r\n"
+		     "Content-Type: application/octet-stream\r\n"
+		     "Content-Disposition: attachment; filename=\"e2631-%s.bin\"\r\n"
+		     "Content-Length: %u\r\n"
+		     "X-E2631-CRC32: 0x%08x\r\n"
+		     "X-E2631-SHA256: %s\r\n"
+		     "X-E2631-Offset: 0x%08x\r\n"
+		     "X-E2631-Length: 0x%08x\r\n"
+		     "X-E2631-Part: %s\r\n"
+		     "Cache-Control: no-store\r\n"
+		     "Connection: close\r\n"
+		     "\r\n",
+		     part, len, crc, sha, off, len, part);
+	if (n <= 0 || (u32)n >= sizeof(c->out)) {
+		free(buf);
+		mtk_tcp_close_conn(c->conn, 1);
+		return;
+	}
+
+	c->backup_buf = buf;
+	c->backup_off = off;
+	c->backup_total = len;
+	c->backup_sent = 0;
+	c->backup_stream = true;
+	c->responded = true;
+	backup_active = true;
+
+	if (mtk_tcp_send_data(c->conn, c->out, (u32)n)) {
+		c->backup_stream = false;
+		backup_active = false;
+		free(buf);
+		c->backup_buf = NULL;
+		mtk_tcp_close_conn(c->conn, 1);
+	}
+}
