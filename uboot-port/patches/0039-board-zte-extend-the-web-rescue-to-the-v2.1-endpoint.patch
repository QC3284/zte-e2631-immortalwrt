+static bool rescue_has_nul_escape(const char *s)
+{
+	while (s[0] && s[1] && s[2]) {
+		if (s[0] == '%' && s[1] == '0' && s[2] == '0')
+			return true;
+		s++;
+	}
+
+	return false;
+}
+
+static void rescue_console_escape(const char *in, char *out, size_t outsz,
+				  bool *truncated)
+{
+	size_t o = 0;
+
+	while (*in) {
+		if (*in == '\r') {
+			in++;
+			continue;
+		}
+		if (o + 2 >= outsz) {
+			*truncated = true;
+			break;
+		}
+		if (*in == '\\') {
+			out[o++] = '\\';
+			out[o++] = '\\';
+		} else if (*in == '\n') {
+			out[o++] = '\\';
+			out[o++] = 'n';
+		} else {
+			out[o++] = *in;
+		}
+		in++;
+	}
+	out[o] = 0;
+}
