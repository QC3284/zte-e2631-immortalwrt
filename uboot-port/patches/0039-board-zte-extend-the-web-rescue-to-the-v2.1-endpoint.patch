+static int rescue_mtd_read(u64 abs, void *buf, u32 len)
+{
+	struct mtd_info *mtd;
+	size_t retlen = 0;
+	int ret;
+
+	mtd_probe_devices();
+	mtd = get_mtd_device_nm(E2631_RESCUE_MTD_DEV);
+	if (!mtd)
+		return -ENODEV;
+	ret = mtd_read(mtd, abs, len, &retlen, buf);
+	put_mtd_device(mtd);
+	if ((ret && ret != -EUCLEAN) || retlen != len)
+		return ret ? ret : -EIO;
+	return 0;
+}
+
+/* CRC32 over the bootloader region for /status; cached until a write. */
+static void rescue_bootloader_crc(u32 *crc)
+{
+	u8 *buf;
+	u32 done = 0;
+	u32 value = 0;
+
+	if (bl_crc_valid) {
+		*crc = bl_crc;
+		return;
+	}
+	buf = malloc(E2631_BACKUP_BLOCK);
+	if (!buf) {
+		*crc = 0;
+		return;
+	}
+	while (done < E2631_RESCUE_FLASH_LEN) {
+		u32 n = E2631_RESCUE_FLASH_LEN - done;
+
+		if (n > E2631_BACKUP_BLOCK)
+			n = E2631_BACKUP_BLOCK;
+		if (rescue_mtd_read(E2631_RESCUE_FLASH_OFF + done, buf, n)) {
+			free(buf);
+			*crc = 0;
+			return;
+		}
+		value = crc32(value, buf, n);
+		done += n;
+	}
+	free(buf);
+	bl_crc = value;
+	bl_crc_valid = true;
+	*crc = value;
+}
