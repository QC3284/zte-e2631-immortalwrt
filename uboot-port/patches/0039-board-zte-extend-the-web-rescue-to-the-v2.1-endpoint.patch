+/* Append with the buffer bookkeeping every status line needs. */
+static void rescue_fmt(char **p, size_t *left, const char *fmt, ...)
+{
+	va_list ap;
+	int n;
+
+	if (*left < 2)
+		return;
+	va_start(ap, fmt);
+	n = vsnprintf(*p, *left, fmt, ap);
+	va_end(ap);
+	if (n <= 0)
+		return;
+	if ((size_t)n >= *left) {
+		*p += *left - 1;
+		*left = 1;
+		return;
+	}
+	*p += n;
+	*left -= (size_t)n;
+}
+
+/* Contract: printable ASCII only, whitespace and '=' become '_'. */
+static void rescue_value(char *dst, size_t dstsz, const char *src)
+{
+	size_t i;
+
+	if (!dstsz)
+		return;
+	if (!src) {
+		dst[0] = 0;
+		return;
+	}
+	for (i = 0; i + 1 < dstsz && src[i]; i++) {
+		unsigned char c = src[i];
+
+		if (c == ' ' || c == '\t' || c == '\r' || c == '\n' || c == '=')
+			dst[i] = '_';
+		else if (c < 0x20 || c > 0x7e)
+			dst[i] = '?';
+		else
+			dst[i] = (char)c;
+	}
+	dst[i] = 0;
+}
+
+/* Percent-decode an HTTP query value in place ('+' becomes a space). */
+static void rescue_url_decode(char *s)
+{
+	char *out = s;
+
+	while (*s) {
+		if (*s == '+') {
+			*out++ = ' ';
+			s++;
+		} else if (*s == '%' && s[1] && s[2]) {
+			int hi = s[1] >= 'a' ? s[1] - 'a' + 10 :
+				 s[1] >= 'A' ? s[1] - 'A' + 10 : s[1] - '0';
+			int lo = s[2] >= 'a' ? s[2] - 'a' + 10 :
+				 s[2] >= 'A' ? s[2] - 'A' + 10 : s[2] - '0';
+
+			if ((hi < 0 || hi > 15) || (lo < 0 || lo > 15)) {
+				*out++ = *s++;
+				continue;
+			}
+			*out++ = (char)((hi << 4) | lo);
+			s += 3;
+		} else {
+			*out++ = *s++;
+		}
+	}
+	*out = 0;
+}
