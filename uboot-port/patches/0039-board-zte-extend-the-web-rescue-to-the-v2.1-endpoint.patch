+static void rescue_handle_env(struct e2631_rescue_conn *c, const char *query,
+			      const char *hdr)
+{
+	char key[64] = "", value[161] = "";
+	char confirm[16] = "";
+	const struct e2631_env_status *es;
+	char err[96];
+	char body[160];
+	int ret, n;
+
+	if (query)
+		rescue_query_value(query, "confirm=", confirm, sizeof(confirm));
+	if (!query || strcmp(confirm, "write") ||
+	    !rescue_header_value(hdr, "X-E2631-Confirm", c->confirm_header,
+				 sizeof(c->confirm_header)) ||
+	    strcmp(c->confirm_header, "write")) {
+		rescue_error_reply(c, "missing confirm");
+		return;
+	}
+
+	rescue_query_value(query, "key=", key, sizeof(key));
+	rescue_query_value(query, "value=", value, sizeof(value));
+	rescue_url_decode(key);
+	rescue_url_decode(value);
+
+	if (!rescue_env_key_writable(key)) {
+		rescue_reply(c, 403, "Forbidden", "text/plain", NULL,
+			     "result=error\nerror=key is not writable\n",
+			     strlen("result=error\nerror=key is not writable\n"));
+		return;
+	}
+	if (!rescue_env_value_ok(value)) {
+		rescue_reply(c, 400, "Bad Request", "text/plain", NULL,
+			     "result=error\nerror=bad value\n",
+			     strlen("result=error\nerror=bad value\n"));
+		return;
+	}
+	if (e2631_env_write_busy()) {
+		rescue_busy_reply(c);
+		return;
+	}
+
+	ret = e2631_env_write_begin(key, value, err, sizeof(err));
+	if (ret < 0) {
+		if (ret == -EPERM)
+			rescue_reply(c, 403, "Forbidden", "text/plain", NULL,
+				     "result=error\nerror=key is not writable\n",
+				     strlen("result=error\nerror=key is not writable\n"));
+		else
+			rescue_error_reply(c, err);
+		return;
+	}
+
+	es = e2631_env_write_state();
+	if (ret == 1) {
+		n = snprintf(body, sizeof(body),
+			     "result=ok\nnew_crc32=0x%08x\nkeys=0\n",
+			     es->new_crc);
+		rescue_reply(c, 200, "OK", "text/plain", NULL, body,
+			     (u32)n);
+		return;
+	}
+
+	env_next_ms = get_timer(0) + E2631_RESCUE_DWELL_MS;
+	rescue_status.op = RESCUE_OP_ENVWRITE;
+	snprintf(rescue_status.mode, sizeof(rescue_status.mode), "write");
+	n = snprintf(body, sizeof(body),
+		     "result=accepted\nnew_crc32=0x%08x\nkeys=1\n",
+		     es->new_crc);
+	rescue_reply(c, 200, "OK", "text/plain", NULL, body, (u32)n);
 }
 
