From 7c7ce92eb627455e94d38a666b5e191ec511d3fb Mon Sep 17 00:00:00 2001
From: QC3284 <2078725082@qq.com>
Date: Sun, 22 Nov 2026 03:55:11 +0800
Subject: [PATCH] cmd: mtd: gate write and erase behind CMD_MTD_WRITE

CONFIG_CMD_MTD compiles the mtd write and erase subcommands into every
build that has the mtd command, which leaves an unguarded raw write
path beside a board update command. Add CMD_MTD_WRITE (bool, default y
to keep the upstream semantics), compile the write and erase subcommand
entries and the write branches in do_mtd_io/do_mtd_erase only when it is
enabled, and leave read, dump and the rest of the command untouched.

The E2631 defconfig disables it, so e2631flash is the only code in the
image that calls mtd_write() or mtd_erase().

Signed-off-by: QC3284 <2078725082@qq.com>
---
 cmd/Kconfig                                | 10 ++++++++++
 cmd/mtd.c                                  | 15 +++++++++++++--
 configs/zx279128s_zte_zxhn-e2631_defconfig |  1 +
 3 files changed, 24 insertions(+), 2 deletions(-)

diff --git a/cmd/Kconfig b/cmd/Kconfig
index c64ca180..eca2be85 100644
--- a/cmd/Kconfig
+++ b/cmd/Kconfig
@@ -1575,6 +1575,16 @@ config CMD_MTD
 	help
 	  MTD commands support.
 
+config CMD_MTD_WRITE
+	bool "mtd write and erase subcommands"
+	depends on CMD_MTD
+	default y
+	help
+	  Enable the write and erase subcommands of the mtd command.
+
+	  Disable this in production bootloader builds where a board command
+	  must be the only path that writes the flash.
+
 config CMD_MTD_OTP
 	bool "mtd otp"
 	depends on CMD_MTD
diff --git a/cmd/mtd.c b/cmd/mtd.c
index ed827acc..52ea4f60 100644
--- a/cmd/mtd.c
+++ b/cmd/mtd.c
@@ -446,6 +446,7 @@ static int do_mtd_list(struct cmd_tbl *cmdtp, int flag, int argc,
 	return CMD_RET_SUCCESS;
 }
 
+#if CONFIG_IS_ENABLED(CMD_MTD_WRITE)
 static int mtd_special_write_oob(struct mtd_info *mtd, u64 off,
 				 struct mtd_oob_ops *io_op,
 				 bool write_empty_pages, bool woob)
@@ -465,6 +466,7 @@ static int mtd_special_write_oob(struct mtd_info *mtd, u64 off,
 
 	return ret;
 }
+#endif
 
 static int do_mtd_io(struct cmd_tbl *cmdtp, int flag, int argc,
 		     char *const argv[])
@@ -578,10 +580,12 @@ static int do_mtd_io(struct cmd_tbl *cmdtp, int flag, int argc,
 
 		if (read)
 			ret = mtd_read_oob(mtd, off, &io_op);
-		else
+#if CONFIG_IS_ENABLED(CMD_MTD_WRITE)
+		else {
 			ret = mtd_special_write_oob(mtd, off, &io_op,
 						    write_empty_pages, woob);
-
+		}
+#endif
 		if (ret) {
 			printf("Failure while %s at offset 0x%llx\n",
 			       read ? "reading" : "writing", off);
@@ -626,6 +630,7 @@ out_put_mtd:
 	return ret;
 }
 
+#if CONFIG_IS_ENABLED(CMD_MTD_WRITE)
 static int do_mtd_erase(struct cmd_tbl *cmdtp, int flag, int argc,
 			char *const argv[])
 {
@@ -714,6 +719,8 @@ out_put_mtd:
 	return ret;
 }
 
+#endif /* CONFIG_IS_ENABLED(CMD_MTD_WRITE) */
+
 #ifdef CONFIG_CMD_MTD_MARKBAD
 static int do_mtd_markbad(struct cmd_tbl *cmdtp, int flag, int argc,
 			  char *const argv[])
@@ -1266,12 +1273,16 @@ U_BOOT_CMD_WITH_SUBCMDS(mtd, "MTD utils", mtd_help_text,
 		U_BOOT_SUBCMD_MKENT(list, 1, 1, do_mtd_list),
 		U_BOOT_SUBCMD_MKENT_COMPLETE(read, 5, 0, do_mtd_io,
 					     mtd_name_complete),
+#if CONFIG_IS_ENABLED(CMD_MTD_WRITE)
 		U_BOOT_SUBCMD_MKENT_COMPLETE(write, 5, 0, do_mtd_io,
 					     mtd_name_complete),
+#endif
 		U_BOOT_SUBCMD_MKENT_COMPLETE(dump, 4, 0, do_mtd_io,
 					     mtd_name_complete),
+#if CONFIG_IS_ENABLED(CMD_MTD_WRITE)
 		U_BOOT_SUBCMD_MKENT_COMPLETE(erase, 4, 0, do_mtd_erase,
 					     mtd_name_complete),
+#endif
 #if CONFIG_IS_ENABLED(CMD_MTD_MARKBAD)
 		U_BOOT_SUBCMD_MKENT_COMPLETE(markbad, 20, 0, do_mtd_markbad,
 					     mtd_name_complete),
diff --git a/configs/zx279128s_zte_zxhn-e2631_defconfig b/configs/zx279128s_zte_zxhn-e2631_defconfig
index da35b78e..de49d0f1 100644
--- a/configs/zx279128s_zte_zxhn-e2631_defconfig
+++ b/configs/zx279128s_zte_zxhn-e2631_defconfig
@@ -23,6 +23,7 @@ CONFIG_BOARD_LATE_INIT=y
 # CONFIG_CMD_SAVEENV is not set
 CONFIG_CMD_MEMTEST=y
 CONFIG_CMD_MTD=y
+# CONFIG_CMD_MTD_WRITE is not set
 CONFIG_OF_CONTROL=y
 CONFIG_OF_EMBED=y
 CONFIG_ENV_IS_IN_MTD=y
-- 
2.56.1

