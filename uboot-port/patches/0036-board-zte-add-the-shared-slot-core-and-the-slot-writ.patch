+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * ZTE ZXHN E2631 firmware slot writer for the web rescue (E4 v2).
+ *
+ * This is the U-Boot-side semantic port of package/e2631/e2631-fwslot/src/
+ * e2631-fwslot.c: package validation, the target/fallback guard matrix, the
+ * serial stamping and the erase/write/verify sequence all come from the
+ * shared core (e2631_slotcore.h) and this thin MTD shim.  It owns slot0 and
+ * slot1 only; mtd0 stays owned by e2631flash and the env block by e2631env.
+ *
+ * Copyright (C) 2026 QC3284
+ */
+
+#ifndef __E2631FWSLOT_H__
+#define __E2631FWSLOT_H__
+
+#include <linux/types.h>
+
+#include "e2631_slotcore.h"
+
+struct e2631_slot_info {
+	bool known;
+	bool valid;
+	bool intact;
+	bool verify_done;
+	enum e2631_slot_identity identity;
+	long hpos;
+	u32 serial;
+	u32 version_len;
+	char version[33];
+	u8 hdr[E2631_VER_HDR_SIZE];
+};
+
+struct e2631_slots {
+	struct e2631_slot_info slot[2];
+	int next_slot;
+	const char *next_reason;
+};
+
+struct e2631_fwslot_validate {
+	int target_slot;
+	enum e2631_slot_identity target_identity;
+	enum e2631_slot_guard guard;
+	const char *guard_reason;
+	u32 body_len;
+	u32 body_crc;
+	u32 written_serial;
+};
+
+enum e2631_fwslot_stage {
+	E2631_FWS_IDLE = 0,
+	E2631_FWS_ERASE,
+	E2631_FWS_WRITE,
+	E2631_FWS_READBACK,
+	E2631_FWS_COMPARE,
+	E2631_FWS_DONE,
+	E2631_FWS_ERROR,
+};
+
+struct e2631_fwslot_status {
+	enum e2631_fwslot_stage stage;
+	int progress;
+	u32 bytes_total;
+	u32 bytes_done;
+	u32 body_crc;
+	u32 written_serial;
+	int target_slot;
+	char error[96];
+};
+
+/* Re-scan the slot headers; full=true also verifies the body CRCs. */
+void e2631_fwslot_refresh(bool full);
+const struct e2631_slots *e2631_fwslot_slots(void);
+
+/* Validate a package and decide the target slot and the guard verdict. */
+int e2631_fwslot_validate(const void *img, u32 len, int slot_sel,
+			  struct e2631_fwslot_validate *out,
+			  char *err, unsigned int errsz);
+
+int e2631_fwslot_begin(int target, const void *img, u32 len);
+int e2631_fwslot_poll(void);
+void e2631_fwslot_end(void);
+const struct e2631_fwslot_status *e2631_fwslot_state(void);
+bool e2631_fwslot_job_open(void);
+
+#endif /* __E2631FWSLOT_H__ */
