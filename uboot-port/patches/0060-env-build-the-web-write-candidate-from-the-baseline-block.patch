diff --git a/board/zte/zxhn-e2631/e2631env_build.h b/board/zte/zxhn-e2631/e2631env_build.h
new file mode 100644
index 00000000..9c0cb432
--- /dev/null
+++ b/board/zte/zxhn-e2631/e2631env_build.h
@@ -0,0 +1,192 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Single-key environment block builder for the web write-back (task-98).
+ *
+ * The rescue page may only persist the one variable named in the request,
+ * so the candidate block is derived from the flash baseline block alone:
+ * every baseline entry is copied with its original bytes and order, and
+ * only the requested key is replaced or appended. The RAM environment and
+ * the runtime keys it carries (fdtcontroladdr, stdin/stdout pointing at the
+ * live serial device, dnsd_domain, ...) never take part in the candidate.
+ *
+ * The header is standalone (no U-Boot includes) so the host fixture can pin
+ * the rule, and e2631env.c writes the candidate with this very function.
+ *
+ * Copyright (C) 2026 QC3284
+ */
+
+#ifndef __BOARD_ZTE_E2631_ENV_BUILD_H__
+#define __BOARD_ZTE_E2631_ENV_BUILD_H__
+
+#include <string.h>
+
+#define E2631_ENV_BUILD_HEADER		4
+#define E2631_ENV_BUILD_MAX_ENTRIES	64
+#define E2631_ENV_BUILD_KEY_MAX		32
+#define E2631_ENV_BUILD_VALUE_MAX	160
+
+struct e2631_env_build_view {
+	const unsigned char *key;
+	unsigned int key_len;
+	const unsigned char *value;
+	unsigned int value_len;
+};
+
+typedef unsigned int (*e2631_env_build_crc_fn)(unsigned int crc,
+					       const unsigned char *buf,
+					       unsigned int len);
+
+static inline unsigned int e2631_env_build_le32(const unsigned char *p)
+{
+	return (unsigned int)p[0] | ((unsigned int)p[1] << 8) |
+	       ((unsigned int)p[2] << 16) | ((unsigned int)p[3] << 24);
+}
+
+static inline void e2631_env_build_put_le32(unsigned char *p,
+					    unsigned int value)
+{
+	p[0] = value & 0xff;
+	p[1] = (value >> 8) & 0xff;
+	p[2] = (value >> 16) & 0xff;
+	p[3] = (value >> 24) & 0xff;
+}
+
+/*
+ * Split a block into views without modifying it. Only the entries before
+ * the first 0x00 are returned, matching the U-Boot environment layout.
+ * Returns 0 and the entry count, or -1 for a malformed block.
+ */
+static inline int e2631_env_build_parse(const unsigned char *block,
+					unsigned int size,
+					struct e2631_env_build_view *views,
+					int max, int *count)
+{
+	unsigned int pos = E2631_ENV_BUILD_HEADER;
+	int n = 0;
+
+	*count = 0;
+	if (!block || size <= E2631_ENV_BUILD_HEADER)
+		return -1;
+
+	while (pos < size) {
+		unsigned int start = pos, end = 0, eq = 0, i;
+
+		if (!block[pos])
+			break;
+
+		while (pos < size && block[pos])
+			pos++;
+		if (pos == size)
+			return -1;
+		end = pos;
+
+		for (i = start; i < end; i++) {
+			if (block[i] == '=') {
+				eq = i;
+				break;
+			}
+		}
+		if (!eq || eq == start)
+			return -1;
+		if (n >= max)
+			return -1;
+
+		views[n].key = block + start;
+		views[n].key_len = eq - start;
+		views[n].value = block + eq + 1;
+		views[n].value_len = end - eq - 1;
+		n++;
+
+		pos = end + 1;
+	}
+
+	*count = n;
+	return 0;
+}
+
+/*
+ * Build the candidate block for one requested key:
+ *   dest        - output block, size bytes, filled on success
+ *   base        - flash baseline block, read when base_valid is true
+ *   base_valid  - false for a blank block (first write)
+ *   key, value  - the only variable the request may persist
+ *   crc_fn      - CRC32 function (U-Boot crc32 in the firmware, a local
+ *                 copy in the host fixture)
+ * Returns 0 and the entry count, or -1 if the baseline or the request is
+ * malformed or the entries do not fit.
+ */
+static inline int e2631_env_build_single(unsigned char *dest,
+					 unsigned int size,
+					 const unsigned char *base,
+					 int base_valid, const char *key,
+					 const char *value,
+					 e2631_env_build_crc_fn crc_fn,
+					 int *count)
+{
+	struct e2631_env_build_view views[E2631_ENV_BUILD_MAX_ENTRIES];
+	unsigned int key_len, value_len, used;
+	int n = 0, found = -1, i;
+	unsigned int crc;
+
+	if (!dest || !key || !value || !crc_fn)
+		return -1;
+	if (size <= E2631_ENV_BUILD_HEADER)
+		return -1;
+
+	memset(dest, 0, size);
+
+	if (base_valid) {
+		if (e2631_env_build_parse(base, size, views,
+					  E2631_ENV_BUILD_MAX_ENTRIES, &n))
+			return -1;
+		for (i = 0; i < n; i++) {
+			if (views[i].key_len == strlen(key) &&
+			    !memcmp(views[i].key, key, views[i].key_len)) {
+				found = i;
+				break;
+			}
+		}
+	}
+
+	key_len = strlen(key);
+	value_len = strlen(value);
+	if (!key_len || key_len > E2631_ENV_BUILD_KEY_MAX ||
+	    value_len > E2631_ENV_BUILD_VALUE_MAX)
+		return -1;
+
+	if (found >= 0) {
+		views[found].value = (const unsigned char *)value;
+		views[found].value_len = value_len;
+	} else {
+		if (n >= E2631_ENV_BUILD_MAX_ENTRIES)
+			return -1;
+		views[n].key = (const unsigned char *)key;
+		views[n].key_len = key_len;
+		views[n].value = (const unsigned char *)value;
+		views[n].value_len = value_len;
+		n++;
+	}
+
+	used = E2631_ENV_BUILD_HEADER;
+	for (i = 0; i < n; i++) {
+		unsigned int need = views[i].key_len + views[i].value_len + 2;
+
+		if (used + need > size)
+			return -1;
+		memcpy(dest + used, views[i].key, views[i].key_len);
+		dest[used + views[i].key_len] = '=';
+		memcpy(dest + used + views[i].key_len + 1, views[i].value,
+		       views[i].value_len);
+		/* the NUL separator is already there because dest is zeroed */
+		used += need;
+	}
+
+	crc = crc_fn(0, dest + E2631_ENV_BUILD_HEADER,
+		     size - E2631_ENV_BUILD_HEADER);
+	e2631_env_build_put_le32(dest, crc);
+
+	*count = n;
+	return 0;
+}
+
+#endif /* __BOARD_ZTE_E2631_ENV_BUILD_H__ */
-- 
