From d229516367c13b5cb3cc16ccc6bdae229e9f0732 Mon Sep 17 00:00:00 2001
From: QC3284 <2078725082@qq.com>
Date: Sun, 22 Nov 2026 11:28:55 +0800
Subject: [PATCH 1/3] drivers/net: add the ZX279128S MDIO controller (E2)

The four integrated PHYs of the ZXHN E2631 sit on addresses 10-13 behind
the SoC's clause-22 MDIO controller at 0x9a101000. Add a driver-model MDIO
bus for it: one command/status transfer with a 2 ms timeout, register
setup deferred to the first transfer (the block must not be touched before
the CRM clocks in the board hook are up), clause-45 addresses rejected.

No DTS node yet; patch 0020 adds it together with the GMAC driver.

Signed-off-by: QC3284 <2078725082@qq.com>
---
 drivers/net/Kconfig          |   8 ++
 drivers/net/Makefile         |   1 +
 drivers/net/zx279128s_eth.h  | 150 +++++++++++++++++++++++++++++++++
 drivers/net/zx279128s_mdio.c | 159 +++++++++++++++++++++++++++++++++++
 4 files changed, 318 insertions(+)
 create mode 100644 drivers/net/zx279128s_eth.h
 create mode 100644 drivers/net/zx279128s_mdio.c

diff --git a/drivers/net/Kconfig b/drivers/net/Kconfig
index 72b77064..25a7ed7a 100644
--- a/drivers/net/Kconfig
+++ b/drivers/net/Kconfig
@@ -126,6 +126,14 @@ config MDIO_AIROHA
 	  This driver supports the MDIO interface found in Airoha
 	  AN7583 SoC.
 
+config MDIO_ZX279128S
+	bool "ZTE ZX279128S MDIO interface support"
+	depends on DM_MDIO
+	help
+	  This driver supports the clause-22 MDIO controller of the ZTE
+	  ZX279128S SoC, whose four integrated PHYs sit on addresses 10-13.
+	  The ZXHN E2631 board uses this bus for its lan1-lan3 and wan ports.
+
 source "drivers/net/airoha/Kconfig"
 
 config AIROHA_ETH
