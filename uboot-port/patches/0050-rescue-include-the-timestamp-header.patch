From de9c1292b0d92a57efec47e00524c0c186bff394 Mon Sep 17 00:00:00 2001
From: QC3284 <2078725082@qq.com>
Date: Sat, 28 Nov 2026 15:26:29 +0800
Subject: [PATCH 9/9] e2631rescue: include the timestamp header for /sysinfo

rescue_sysinfo_text() reports U_BOOT_DATE and U_BOOT_TIME, but those
macros live in timestamp.h (generated/timestamp_autogenerated.h), not in
version.h.  The task-92 unified build failed with

  e2631rescue.c:1172:49: error: 'U_BOOT_DATE' undeclared

so include timestamp.h explicitly, the same way common/version.c does.

Signed-off-by: QC3284 <2078725082@qq.com>
---
 board/zte/zxhn-e2631/e2631rescue.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/board/zte/zxhn-e2631/e2631rescue.c b/board/zte/zxhn-e2631/e2631rescue.c
index 0bc47b6a..afc39ed2 100644
--- a/board/zte/zxhn-e2631/e2631rescue.c
+++ b/board/zte/zxhn-e2631/e2631rescue.c
@@ -57,6 +57,7 @@
 #include <stdio.h>
 #include <string.h>
 #include <time.h>
+#include <timestamp.h>
 #include <u-boot/crc.h>
 #include <u-boot/sha256.h>
 #include <version_string.h>
-- 
2.56.1

