From bceb54273c435b812e559cd527e3563a93b0d96b Mon Sep 17 00:00:00 2001
From: QC3284 <2078725082@qq.com>
Date: Sat, 28 Nov 2026 15:05:54 +0800
Subject: [PATCH 6/8] rescue: stream the slot and rootfs backups (task-90)

The v3 /backup table gains four parts: slot0 and slot1 stream a whole
0x01C00000 span, while rootfs and header follow the slot the next boot
would use (next_slot decides between the two windows in the contract).

Whole-slot parts use a 1 MiB cache-aligned bounce buffer and two passes:
the first pass computes CRC32 and SHA-256 over the region, the second
passes the same bytes out through DATA_SENT.  The five v2.1 parts keep the
16 KiB block.  A second stream while one is active is still 409 busy and
an unknown part is still 400 bad part.

/status gains backup=idle|active and backup_part, both cleared when the
stream ends or the connection is dropped.  Nothing here writes flash.

Signed-off-by: QC3284 <2078725082@qq.com>
---
 board/zte/zxhn-e2631/e2631rescue.c | 42 +++++++++++++++++++++++++-----
 1 file changed, 36 insertions(+), 6 deletions(-)

diff --git a/board/zte/zxhn-e2631/e2631rescue.c b/board/zte/zxhn-e2631/e2631rescue.c
index 15241d1e..a6143617 100644
--- a/board/zte/zxhn-e2631/e2631rescue.c
+++ b/board/zte/zxhn-e2631/e2631rescue.c
@@ -44,6 +44,7 @@
 #include <env_internal.h>
 #include <errno.h>
 #include <malloc.h>
+#include <memalign.h>
 #include <mtd.h>
 #include <net.h>
 #include <search.h>
@@ -198,6 +199,7 @@ static bool factory_finished;
 static unsigned long factory_next_ms;
 static unsigned long env_next_ms;
 static bool backup_active;
+static char rescue_backup_part_name[16];
 static bool slots_ready;
 static bool bl_crc_valid;
 static u32 bl_crc;
@@ -246,6 +248,7 @@ struct e2631_rescue_conn {
 	u32 backup_off;
 	u32 backup_sent;
 	u32 backup_total;
+	u32 backup_block;
 	u8 out[E2631_RESCUE_OUT_MAX];
 };
 
@@ -959,6 +962,9 @@ static void rescue_status_text(char *buf, size_t bufsz)
 	rescue_fmt(&p, &left, "log_bytes=%u\n", rescue_log_bytes);
 	rescue_fmt(&p, &left, "log_overflow=%d\n",
 		   rescue_log_overflow ? 1 : 0);
+	rescue_fmt(&p, &left, "backup=%s\n",
+		   backup_active ? "active" : "idle");
+	rescue_fmt(&p, &left, "backup_part=%s\n", rescue_backup_part_name);
 
 	if (!rescue_fmt_fault && p != buf + (bufsz - left))
 		rescue_fmt_range_fail("p and left no longer agree");
@@ -1279,9 +1285,26 @@ static int rescue_backup_part(const char *name, u32 *off, u32 *len)
 		{ "wifi", 0x00200000U, 0x00100000U },
 		{ "usercfg", 0x00300000U, 0x00200000U },
 		{ "defcfg", 0x00500000U, 0x00200000U },
+		{ "slot0", E2631_SLOT0_BASE, E2631_SLOT_SPAN },
+		{ "slot1", E2631_SLOT1_BASE, E2631_SLOT_SPAN },
 	};
 	int i;
 
+	/* rootfs and header follow the slot the next boot would use. */
+	if (!strcmp(name, "rootfs") || !strcmp(name, "header")) {
+		const struct e2631_slots *slots = e2631_fwslot_slots();
+		int next = slots ? slots->next_slot : 0;
+
+		if (!strcmp(name, "rootfs")) {
+			*off = next == 0 ? 0x00B00000U : 0x02700000U;
+			*len = 0x01100000U;
+		} else {
+			*off = next == 0 ? 0x01C00000U : 0x03800000U;
+			*len = 0x00020000U;
+		}
+		return 0;
+	}
+
 	for (i = 0; i < ARRAY_SIZE(parts); i++) {
 		if (!strcmp(parts[i].name, name)) {
 			*off = parts[i].off;
@@ -1300,8 +1323,8 @@ static int rescue_backup_block(struct e2631_rescue_conn *c)
 
 	if (!n)
 		return 0;
-	if (n > E2631_BACKUP_BLOCK)
-		n = E2631_BACKUP_BLOCK;
+	if (n > c->backup_block)
+		n = c->backup_block;
 	if (rescue_mtd_read(c->backup_off + c->backup_sent, c->backup_buf, n))
 		return -EIO;
 	if (mtk_tcp_send_data(c->conn, c->backup_buf, n))
@@ -1317,7 +1340,7 @@ static void rescue_backup_start(struct e2631_rescue_conn *c, const char *query)
 	u8 digest[SHA256_SUM_LEN];
 	char sha[SHA256_SUM_LEN * 2 + 1];
 	char part[16] = "bootloader";
-	u32 off, len, crc = 0, done = 0;
+	u32 off, len, crc = 0, done = 0, blk;
 	u8 *buf;
 	int n;
 
@@ -1334,7 +1357,9 @@ static void rescue_backup_start(struct e2631_rescue_conn *c, const char *query)
 		return;
 	}
 
-	buf = malloc(E2631_BACKUP_BLOCK);
+	blk = (!strcmp(part, "slot0") || !strcmp(part, "slot1") ||
+	       !strcmp(part, "rootfs")) ? 0x100000U : E2631_BACKUP_BLOCK;
+	buf = malloc_cache_aligned(blk);
 	if (!buf) {
 		rescue_error_reply(c, "out of memory");
 		return;
@@ -1345,8 +1370,8 @@ static void rescue_backup_start(struct e2631_rescue_conn *c, const char *query)
 	while (done < len) {
 		u32 n2 = len - done;
 
-		if (n2 > E2631_BACKUP_BLOCK)
-			n2 = E2631_BACKUP_BLOCK;
+		if (n2 > blk)
+			n2 = blk;
 		if (rescue_mtd_read(off + done, buf, n2))
 			break;
 		crc = crc32(crc, buf, n2);
@@ -1387,8 +1412,11 @@ static void rescue_backup_start(struct e2631_rescue_conn *c, const char *query)
 	c->backup_off = off;
 	c->backup_total = len;
 	c->backup_sent = 0;
+	c->backup_block = blk;
 	c->backup_stream = true;
 	c->responded = true;
+	snprintf(rescue_backup_part_name, sizeof(rescue_backup_part_name),
+		 "%s", part);
 	backup_active = true;
 
 	if (mtk_tcp_send_data(c->conn, c->out, (u32)n)) {
@@ -2384,10 +2412,12 @@ static void rescue_tcp_cb(struct mtk_tcp_cb_data *cbd)
 			if (c->backup_sent >= c->backup_total) {
 				c->backup_stream = false;
 				backup_active = false;
+				rescue_backup_part_name[0] = 0;
 				mtk_tcp_close_conn(c->conn, 0);
 			} else if (rescue_backup_block(c)) {
 				c->backup_stream = false;
 				backup_active = false;
+				rescue_backup_part_name[0] = 0;
 				mtk_tcp_close_conn(c->conn, 1);
 			}
 			return;
-- 
