diff --git a/net/arp.c b/net/arp.c
index 4801dca6..103a0ebc 100644
--- a/net/arp.c
+++ b/net/arp.c
@@ -37,6 +37,22 @@ void arp_init(void)
 	arp_tx_packet -= (ulong)arp_tx_packet % PKTALIGN;
 }
 
+void arp_wait_clear(void)
+{
+	/*
+	 * Drop any pending ARP resolution.  Called when the owner of the wait
+	 * state goes away: arp_wait_packet_ethaddr points into a buffer that is
+	 * about to be freed, and a poll loop that never runs
+	 * arp_timeout_check() would otherwise carry the state into the next
+	 * session and write through a dangling pointer.
+	 */
+	net_arp_wait_packet_ip.s_addr = 0;
+	net_arp_wait_reply_ip.s_addr = 0;
+	arp_wait_packet_ethaddr = NULL;
+	arp_wait_tx_packet_size = 0;
+	arp_wait_try = 0;
+}
+
 void arp_raw_request(struct in_addr source_ip, const uchar *target_ethaddr,
 	struct in_addr target_ip)
 {
