diff --git a/include/net/mtk_dnsd.h b/include/net/mtk_dnsd.h
new file mode 100644
index 00000000..f6a24904
--- /dev/null
+++ b/include/net/mtk_dnsd.h
@@ -0,0 +1,197 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Copyright (C) 2026 Yuzhii0718
+ *
+ * Minimal DNS server for MediaTek web failsafe.
+ * Resolves a configurable domain name to the device's IP address,
+ * allowing users to access the failsafe UI via a friendly hostname.
+ *
+ * Ported for the ZTE ZXHN E2631 rescue page from
+ * bl-mt798x-dhcpd (tail of the U-Boot fork), commit
+ * e4cf4dc72d451dc7a86c9508390ad5a2e50743c4, GPL-2.0.
+ *
+ * The wire helpers (name parsing, case-insensitive matching and the
+ * A-record reply layout) live in this header so the host fixture can
+ * exercise them without the U-Boot network stack.  The handler in
+ * net/mtk_dnsd.c adds the Ethernet/IP/UDP framing and the handler
+ * registration.
+ */
+
+#ifndef __NET_MTK_DNSD_H__
+#define __NET_MTK_DNSD_H__
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+
+/* DNS wire constants used by the tiny reply builder. */
+#define MTK_DNSD_FLAG_QR	0x8000
+#define MTK_DNSD_FLAG_AA	0x0400
+#define MTK_DNSD_FLAG_RD	0x0100
+#define MTK_DNSD_RCODE_NOERROR	0x0000
+#define MTK_DNSD_RCODE_NXDOMAIN	0x0003
+#define MTK_DNSD_CLASS_IN	0x0001
+#define MTK_DNSD_TYPE_A		0x0001
+#define MTK_DNSD_TTL		300
+#define MTK_DNSD_NAME_MAX	256
+
+/*
+ * Parse a DNS name label-by-label to obtain the total octet length of the
+ * raw encoded name in the query packet (including the terminating
+ * zero-length label).  Returns 0 on failure.
+ */
+static inline int mtk_dnsd_parse_name_len(const unsigned char *pkt, int pkt_len,
+					  int offset)
+{
+	int count = 0;
+	int hopped = 0;
+
+	while (hopped < 10) {
+		uint8_t label_len;
+
+		if (offset < 0 || offset >= pkt_len)
+			return 0;
+		label_len = pkt[offset];
+
+		if (label_len == 0)
+			return count + 1;
+
+		if ((label_len & 0xC0) == 0xC0)
+			return count + 2;
+
+		count += label_len + 1;
+		offset += label_len + 1;
+		hopped++;
+	}
+
+	return 0;
+}
+
+/*
+ * Check whether the DNS name in the query matches our configured domain.
+ * Matching is case-insensitive.
+ */
+static inline bool mtk_dnsd_name_matches(const unsigned char *pkt, int pkt_len,
+					 int offset, const char *domain)
+{
+	const char *d = domain;
+
+	while (*d) {
+		uint8_t label_len;
+		int i;
+
+		if (offset < 0 || offset >= pkt_len)
+			return false;
+
+		label_len = pkt[offset];
+		if (label_len == 0 || (label_len & 0xC0))
+			return false;
+
+		offset++;
+
+		for (i = 0; i < label_len; i++) {
+			char dc, pc;
+
+			if (offset >= pkt_len)
+				return false;
+
+			dc = *d++;
+			if (dc >= 'A' && dc <= 'Z')
+				dc += 'a' - 'A';
+			pc = pkt[offset];
+			if (pc >= 'A' && pc <= 'Z')
+				pc += 'a' - 'A';
+
+			if (dc != pc)
+				return false;
+			offset++;
+		}
+
+		if (*d == '.')
+			d++;
+		else if (*d != '\0')
+			return false;
+	}
+
+	if (offset >= pkt_len || pkt[offset] != 0)
+		return false;
+
+	return true;
+}
+
+/*
+ * Build a DNS reply payload (header + echoed question + optional A answer).
+ *
+ * @query:     received DNS payload
+ * @name_off:  offset of the question name (normally 12)
+ * @name_len:  encoded name length from mtk_dnsd_parse_name_len()
+ * @rcode:     MTK_DNSD_RCODE_*
+ * @ip:        IPv4 address in network byte order for the A record
+ * @out:       output buffer (at least 12 + name_len + 4 + 16 bytes)
+ * @outsz:     size of @out
+ *
+ * Return: reply length, or -1 when @out is too small.
+ *
+ * With @rcode == NXDOMAIN or @ip == 0 the reply carries no answer record.
+ */
+static inline int mtk_dnsd_build_reply(const unsigned char *query, int name_off,
+				       int name_len, uint16_t rcode, uint32_t ip,
+				       unsigned char *out, int outsz)
+{
+	bool answer = (rcode == MTK_DNSD_RCODE_NOERROR) && ip;
+	uint16_t flags;
+	uint32_t ttl = MTK_DNSD_TTL;
+	int pos;
+
+	if (outsz < 12 + name_len + 4 || (answer && outsz < 12 + name_len + 4 + 16))
+		return -1;
+
+	out[0] = query[0];
+	out[1] = query[1];
+
+	flags = MTK_DNSD_FLAG_QR | MTK_DNSD_FLAG_AA |
+		(((uint16_t)query[2] << 8 | query[3]) & MTK_DNSD_FLAG_RD) | rcode;
+	out[2] = (flags >> 8) & 0xFF;
+	out[3] = flags & 0xFF;
+
+	out[4] = query[4];
+	out[5] = query[5];
+	out[6] = 0;
+	out[7] = answer ? 1 : 0;
+	out[8] = 0;
+	out[9] = 0;
+	out[10] = 0;
+	out[11] = 0;
+
+	memcpy(out + 12, query + name_off, name_len + 4);
+	pos = 12 + name_len + 4;
+
+	if (answer) {
+		/* Compression pointer to the question name (0xC00C). */
+		out[pos++] = 0xC0;
+		out[pos++] = 0x0C;
+		/* Type A, class IN. */
+		out[pos++] = 0x00;
+		out[pos++] = 0x01;
+		out[pos++] = 0x00;
+		out[pos++] = 0x01;
+		/* TTL. */
+		out[pos++] = (ttl >> 24) & 0xFF;
+		out[pos++] = (ttl >> 16) & 0xFF;
+		out[pos++] = (ttl >> 8) & 0xFF;
+		out[pos++] = ttl & 0xFF;
+		/* RDLENGTH = 4, RDATA = the address in network order. */
+		out[pos++] = 0x00;
+		out[pos++] = 0x04;
+		memcpy(out + pos, &ip, 4);
+		pos += 4;
+	}
+
+	return pos;
+}
+
+int mtk_dnsd_start(void);
+void mtk_dnsd_stop(void);
+bool mtk_dnsd_is_running(void);
+
+#endif /* __NET_MTK_DNSD_H__ */
