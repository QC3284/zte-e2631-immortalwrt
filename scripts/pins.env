# E2631 pin file (T-12, 2026-11-14; plan C re-pin, 2026-11-21).
# Sourced by scripts/env.sh; keep it plain KEY=VALUE shell - no spaces around
# '=', no command substitution, no ${VAR:-default} expressions.
# scripts/base-pin-check.sh reads it literally.
#
# This file replaced base/commits.env when the tree-fork migration retired the
# vendored patch series (overlay/, base/, apply.sh). The project now builds the
# E2631 support straight out of QC3284/immortalwrt branch e2631, a fork of
# immortalwrt/immortalwrt pinned at E2631_IW_SHA. A change to any value below
# is a deliberate pin update, never a silent one.
#
# TRIPLE PIN (checked by scripts/bootstrap.sh and make check):
#   the upstream ImmortalWrt commit + the content the reviewed port commits
#   produce (E2631_BASE_TREE_SHA, the tree of the last zx279128 port commit) +
#   the tree-fork tip the build checks out (E2631_FORK_SHA). The ancestry
#   assertion pins the four reviewed port commits on the fork history.

# --- the ImmortalWrt base ---------------------------------------------------
# immortalwrt/immortalwrt master @ 2026-11-14 (merge "Merge Official Source"),
# kernel 6.18.60. Plan C rebased the whole E2631 series onto this commit.
E2631_IW_REPO=https://github.com/immortalwrt/immortalwrt
E2631_IW_BRANCH=master
E2631_IW_SHA=a4ba8240d8a1aaef7e8c6f2d65e841a9bfd2b8c5
# git rev-parse <E2631_IW_SHA>^{tree} - the pristine upstream tree.
E2631_IW_TREE_SHA=b905483c80a3a705825ff7aa9c77d1f3db4a01c3
# LINUX_VERSION-6.18 from target/linux/generic/kernel-6.18.
E2631_BASE_KERNEL=6.18.60

# --- the tree fork (device support as real commits) -------------------------
# The kit clones this fork at E2631_FORK_SHA. Plan C (2026-11-21) rebuilt the
# whole series on E2631_IW_SHA instead of merging upstream: the branch is
# rebased onto that commit and the target was renamed sanechips -> zx279128 to
# match the SoC naming mainline expects. The 15 commits above E2631_IW_SHA are:
# the four reviewed port commits (author/dates preserved), then the E2631
# device support, the mainline-quality fix series (extroot marker, WAN access
# defaults, fstools jffs2 sync, DEVMEM in the seed, userdata empty-marker gate,
# checkpatch cleanup), the firewall4 fullcone re-anchor and the stale
# TARGET_sanechips dependency fix. The pre-plan-C
# history is preserved in branch e2631-legacy.
# E2631_FORK_DEPTH is the history window of the SCRATCH repo used for the
# ancestry assertions (the build tree itself is always fetched at depth 1,
# parity P2: rules.mk COMMITCOUNT is "git rev-list --count HEAD ."). Measured
# against this tip: the last port commit 4ca29c6550 is 11 levels below the tip
# (10 commits between), E2631_IW_SHA is 16 levels below, so the window must be
# >= 16; 32 keeps a wide margin for future CI-only commits.
E2631_FORK_REPO=https://github.com/QC3284/immortalwrt
E2631_FORK_BRANCH=e2631
E2631_FORK_SHA=d74ec77aff719a74c6643e540af74ae5a2f85925
E2631_FORK_DEPTH=32

# --- the reviewed zx279128 port, as content ---------------------------------
# Plan C rebuilt target/linux/sanechips as target/linux/zx279128. The last port
# commit 4ca29c655076ef074d3a69945d76021cdf43a5d4 ("zx279128: add support for
# ZTE ZXHN H3600") carries this tree; the scratch history must contain it, so
# a rebase onto another base cannot pass silently.
E2631_BASE_TREE_SHA=6136bd92d5259dbaf22f6bca02c675f05abdf86b

# --- provenance of the reviewed port series ---------------------------------
# The old kit vendored a four-patch git-am series. Those patch files are
# retired; the reviewed content now lives as four real commits in the tree
# fork. Plan C re-derived them on E2631_IW_SHA while keeping the original
# authors and dates, so provenance is the fork history plus these identifiers
# of the mirror the series was originally reviewed from.
E2631_PORT_REPO=https://github.com/Zlion-Y/openwrt-sanechips-mirror
E2631_PORT_BRANCH=pr-zte-zxhn-h3600
E2631_PORT_SHA=db8b8d4130457dbe46558a7cea872dd2dae539e6
E2631_PORT_BASE_SHA=936617ab598e02665fafcf2a180d0d5505c648c4
# The four reviewed port commits in the fork, oldest first:
#   af89c4703bf7866bbc8969a0cae38a8a2b195786 zx279128: add generic DWC3 platform glue driver
#   c300b1eca53171a463ba1c28201e7d4d4adb3b79 mt76: serialize device reads with outer cache maintenance
#   7a19c62cbc8f3025f8135268b7898493e025ba02 zx279128: add ZX279128S target
#   4ca29c655076ef074d3a69945d76021cdf43a5d4 zx279128: add support for ZTE ZXHN H3600

# --- feed commits (parity P3) ----------------------------------------------
# The v1.10.0 reference build used exactly these feed commits
# (evidence/immortalwrt-verify-20261114.md). scripts/bootstrap.sh fetches these
# commits and refuses a moving branch tip, so a feed update cannot silently
# change the image. The URLs come from the base tree's feeds.conf.default.
E2631_FEED_PACKAGES_SHA=decf94639ffd6ddd26591c190b547c6b7eea150b
E2631_FEED_LUCI_SHA=ad75cde88e694b511100576bfbe0a280e5efe6ef
