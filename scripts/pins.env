# E2631 pin file (T-12, 2026-11-14). Sourced by scripts/env.sh; keep it
# plain KEY=VALUE shell - no spaces around '=', no command substitution, no
# ${VAR:-default} expressions. scripts/base-pin-check.sh reads it literally.
#
# This file replaced base/commits.env when the tree-fork migration retired the
# vendored patch series (overlay/, base/, apply.sh). The project now builds the
# E2631 support straight out of QC3284/immortalwrt branch e2631, a fork of
# immortalwrt/immortalwrt pinned at E2631_IW_SHA. A change to any value below
# is a deliberate pin update, never a silent one.
#
# TRIPLE PIN (checked by scripts/bootstrap.sh and make check):
#   the upstream ImmortalWrt commit + the content every fork commit produces
#   (E2631_BASE_TREE_SHA, the tree of the last sanechips port commit) + the
#   tree-fork tip the build checks out (E2631_FORK_SHA). The ancestry assertion
#   pins the four reviewed sanechips commits directly on E2631_IW_SHA.

# --- the ImmortalWrt base ---------------------------------------------------
# immortalwrt/immortalwrt master @ 2026-11-05T04:06:13Z, kernel 6.18.60.
E2631_IW_REPO=https://github.com/immortalwrt/immortalwrt
E2631_IW_BRANCH=master
E2631_IW_SHA=4765b657625ec5bbda74b44400465fe043802b30
# git rev-parse <E2631_IW_SHA>^{tree} - the pristine upstream tree.
E2631_IW_TREE_SHA=340ae5426d1c8dfa071e97f08993393b87a47671
# LINUX_VERSION-6.18 from target/linux/generic/kernel-6.18.
E2631_BASE_KERNEL=6.18.60

# --- the tree fork (device support as real commits) -------------------------
# The kit clones this fork at E2631_FORK_SHA. The four sanechips commits sit
# directly on E2631_IW_SHA; the last of them produces E2631_BASE_TREE_SHA.
# Above them are the E2631 device commits and, since 2026-11-14, the
# mainline-quality fix series (extroot snapshot marker, WAN access defaults,
# fstools jffs2 sync, CONFIG_DEVMEM in the seed, checkpatch cleanup) plus the
# history-rewrite/force-push note the fork branch was force-pushed with. The
# pin is that reviewed content tip; the previous pin e96aed31 is its ancestor,
# so the build content and the four port commits stay auditable.
# E2631_FORK_DEPTH is the history window of the SCRATCH repo used for the
# ancestry assertions (the build tree itself is always fetched at depth 1,
# parity P2: rules.mk COMMITCOUNT is "git rev-list --count HEAD ."). The
# base-port commit is 12 levels below this tip, so the window must be >= 12.
E2631_FORK_REPO=https://github.com/QC3284/immortalwrt
E2631_FORK_BRANCH=e2631
E2631_FORK_SHA=83df1a90a71863c2f54d6e399e8b0ee86405083a
E2631_FORK_DEPTH=32

# --- the reviewed sanechips port, as content ---------------------------------
# git -C "$E2631_TREE" rev-parse 671018283968a42db5a64bcf919daa66f8ea0901^{tree}
# after the four git-am commits in the old kit (author/time independent), and
# the tree the fork's 6710182 commit carries today. The scratch history must
# contain it, so a rebase onto another base cannot pass silently.
E2631_BASE_TREE_SHA=4f89aa7ad0a5132dc047a27a9073b43916f0f957

# --- provenance of the vendored series the fork was created from ------------
# The patch files themselves are gone (the fork carries the commits); these
# hashes stay so the reviewed series remains identifiable.
E2631_PORT_REPO=https://github.com/Zlion-Y/openwrt-sanechips-mirror
E2631_PORT_BRANCH=pr-zte-zxhn-h3600
E2631_PORT_SHA=db8b8d4130457dbe46558a7cea872dd2dae539e6
E2631_PORT_BASE_SHA=936617ab598e02665fafcf2a180d0d5505c648c4
E2631_BASE_PATCH_SHA256_0001=669f41e436c258d2982dc5998efe82ae54230fbfaa0c1cd60fd148d067c07ffc
E2631_BASE_PATCH_SHA256_0002=a512521bd8ae6dba12b44e989e1a6554e0ed0dd21e769dd453a6fafb5a472dcf
E2631_BASE_PATCH_SHA256_0003=67280d1b531b0a9734f1083b527f933a47c68711b5d0d9820bc38c2bba2dc4d7
E2631_BASE_PATCH_SHA256_0004=8f4b2eee62d23f7be0923d742b7eb32fcb207ee936fcac20296020f769490035

# --- feed commits (parity P3) ----------------------------------------------
# The v1.10.0 reference build used exactly these feed commits
# (evidence/immortalwrt-verify-20261114.md). scripts/bootstrap.sh fetches these
# commits and refuses a moving branch tip, so a feed update cannot silently
# change the image. The URLs come from the base tree's feeds.conf.default.
E2631_FEED_PACKAGES_SHA=decf94639ffd6ddd26591c190b547c6b7eea150b
E2631_FEED_LUCI_SHA=ad75cde88e694b511100576bfbe0a280e5efe6ef
