# E2631 port base pin (T2, 2026-11-14). Sourced by scripts/env.sh; keep it
# plain KEY=VALUE shell - no spaces around '=', no command substitution.
#
# TRIPLE PIN: the ImmortalWrt commit below + the sha256 of every patch in this
# directory + the tree hash those four patches must produce. scripts/bootstrap.sh
# checks all three before it lets a tree through, and apply.sh / make check
# re-check the tree hash. A change to any of them is a deliberate pin update
# (see base/README.md), never a silent one.
#
# The series is the sanechips target port from Zlion-Y/openwrt-sanechips-mirror
# (branch pr-te-zxhn-h3600), vendored here so this kit does not need a second
# pinned repository. Authors and commit messages are preserved by
# git format-patch / git am. Licenses: GPL-2.0 only (upstream OpenWrt port).

# --- the ImmortalWrt base (E2631_BASE_KIND=immortalwrt) ---------------------
# immortalwrt/immortalwrt master @ 2026-11-05T04:06:13Z, kernel 6.18.60.
E2631_IW_REPO=https://github.com/immortalwrt/immortalwrt
E2631_IW_BRANCH=master
E2631_IW_SHA=4765b657625ec5bbda74b44400465fe043802b30
# git rev-parse <E2631_IW_SHA>^{tree} - the pristine upstream tree.
E2631_IW_TREE_SHA=340ae5426d1c8dfa071e97f08993393b87a47671
# LINUX_VERSION-6.18 from target/linux/generic/kernel-6.18; asserted by apply.sh.
E2631_BASE_KERNEL=6.18.60

# --- where the vendored series came from (provenance) -----------------------
E2631_PORT_REPO=https://github.com/Zlion-Y/openwrt-sanechips-mirror
E2631_PORT_BRANCH=pr-zte-zxhn-h3600
# The PR head the four commits live at (2026-10-12T17:14:44Z, kernel 6.18.55).
E2631_PORT_SHA=db8b8d4130457dbe46558a7cea872dd2dae539e6
# The upstream commit the four port commits are based on: an ImmortalWrt
# ancestor (ahead_by 6049 / behind_by 0), which is why they re-apply cleanly.
E2631_PORT_BASE_SHA=936617ab598e02665fafcf2a180d0d5505c648c4

# --- the vendored patches (sha256 of THIS directory's files) ----------------
# 0002 is not byte-identical to the upstream commit: its Makefile hunk is
# dropped because the pinned bases already carry PKG_RELEASE:=2; apply.sh bumps
# it to :=3. Everything else is verbatim. See base/README.md.
E2631_BASE_PATCH_SHA256_0001=669f41e436c258d2982dc5998efe82ae54230fbfaa0c1cd60fd148d067c07ffc
E2631_BASE_PATCH_SHA256_0002=a512521bd8ae6dba12b44e989e1a6554e0ed0dd21e769dd453a6fafb5a472dcf
E2631_BASE_PATCH_SHA256_0003=67280d1b531b0a9734f1083b527f933a47c68711b5d0d9820bc38c2bba2dc4d7
E2631_BASE_PATCH_SHA256_0004=8f4b2eee62d23f7be0923d742b7eb32fcb207ee936fcac20296020f769490035

# --- the resulting tree (the identity apply.sh and make check verify) ------
# git -C "$E2631_TREE" rev-parse 'HEAD^{tree}' after the four git-am commits.
# Local commit SHAs differ per machine (git am makes new commits); the TREE
# hash is content-only, so it is the stable identity. apply.sh copies/edits the
# worktree but never commits, so HEAD^{tree} keeps this value after apply.
E2631_BASE_TREE_SHA=4f89aa7ad0a5132dc047a27a9073b43916f0f957

# --- the tree fork (Phase 2: device support as real commits) ----------------
# The kit clones this fork instead of git-am'ing the series above. E2631_FORK_SHA
# is the branch tip the kit is verified against; scripts/bootstrap.sh proves from
# content that the fetched history still contains the base-port tree below and
# that the four sanechips commits sit directly on E2631_IW_SHA, so the fork can
# neither drift nor be rebased onto another base silently.
# NOTE: task-12 moves these four lines to scripts/pins.env when base/ is deleted.
# REPO/BRANCH/DEPTH are overridable defaults (an exported variable wins, as
# everywhere else in env.sh) so a local rehearsal can point at a working copy;
# the SHA is the pin itself and is never overridden. DEPTH is the history window
# of the SCRATCH repo used for the ancestry assertions (must reach the upstream
# pin, 8 commits back); the build tree itself is always fetched at depth 1 (P2).
E2631_FORK_REPO=${E2631_FORK_REPO:-https://github.com/QC3284/immortalwrt}
E2631_FORK_BRANCH=${E2631_FORK_BRANCH:-e2631}
E2631_FORK_SHA=e96aed31c45442374e9a37fd84c1ac048be90613
E2631_FORK_DEPTH=${E2631_FORK_DEPTH:-32}
