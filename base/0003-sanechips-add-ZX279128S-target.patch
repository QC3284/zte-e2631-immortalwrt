diff --git a/target/linux/sanechips/patches-6.18/015-dt-bindings-PCI-Add-ZTE-ZX279128S-host-controller.patch b/target/linux/sanechips/patches-6.18/015-dt-bindings-PCI-Add-ZTE-ZX279128S-host-controller.patch
new file mode 100644
index 0000000000..a0c3eb3727
--- /dev/null
+++ b/target/linux/sanechips/patches-6.18/015-dt-bindings-PCI-Add-ZTE-ZX279128S-host-controller.patch
@@ -0,0 +1,139 @@
+From 159cbb8a6992333d59d98984878776d97d900eea Mon Sep 17 00:00:00 2001
+From: Navid Ghahremani <ghahramani.navid@gmail.com>
+Date: Mon, 12 Oct 2026 07:48:26 +0100
+Subject: [PATCH 12/24] dt-bindings: PCI: Add ZTE ZX279128S host controller
+
+Add Device Tree binding for the DesignWare PCIe host controller on the
+ZTE ZX279128S SoC, using standard clocks, resets, and phys properties.
+
+Signed-off-by: Navid Ghahremani <ghahramani.navid@gmail.com>
+---
+
+diff --git a/Documentation/devicetree/bindings/pci/zte,zx279128s-pcie.yaml b/Documentation/devicetree/bindings/pci/zte,zx279128s-pcie.yaml
+new file mode 100644
+index 0000000000..716027ad06
+--- /dev/null
++++ b/Documentation/devicetree/bindings/pci/zte,zx279128s-pcie.yaml
+@@ -0,0 +1,120 @@
++# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
++%YAML 1.2
++---
++$id: http://devicetree.org/schemas/pci/zte,zx279128s-pcie.yaml#
++$schema: http://devicetree.org/meta-schemas/core.yaml#
++
++title: ZTE zx279128s PCIe host controller
++
++maintainers:
++  - Navid Ghahremani <ghahramani.navid@gmail.com>
++
++description:
++  The ZTE zx279128s has two PCIe host controllers based on the Synopsys
++  DesignWare PCIe IP, each with one lane. Their clocks, resets and PHYs are
++  controlled through the SoC's Top CRM blocks.
++
++allOf:
++  - $ref: /schemas/pci/snps,dw-pcie.yaml#
++
++properties:
++  compatible:
++    const: zte,zx279128s-pcie
++
++  reg:
++    items:
++      - description: Data Bus Interface (DBI) registers
++      - description: Controller wrapper registers
++      - description: PCIe configuration space region
++
++  reg-names:
++    items:
++      - const: dbi
++      - const: ctrl
++      - const: config
++
++  interrupts:
++    maxItems: 1
++
++  clocks:
++    items:
++      - description: PCIe controller clock
++
++  clock-names:
++    items:
++      - const: pcie
++
++  resets:
++    items:
++      - description: PCIe controller reset
++
++  reset-names:
++    items:
++      - const: pcie
++
++  phys:
++    maxItems: 1
++
++  phy-names:
++    items:
++      - const: pcie
++
++  reset-gpios:
++    maxItems: 1
++    description: Optional board GPIO reset line for downstream endpoints.
++
++  enable-gpios:
++    maxItems: 1
++    description: Optional second board GPIO enable line driven together with reset-gpios.
++
++required:
++  - reg
++  - reg-names
++  - interrupts
++  - '#interrupt-cells'
++  - interrupt-map
++  - interrupt-map-mask
++  - clocks
++  - clock-names
++  - resets
++  - reset-names
++  - phys
++  - phy-names
++
++unevaluatedProperties: false
++
++examples:
++  - |
++    #include <dt-bindings/clock/zte,zx279128s-crm.h>
++    #include <dt-bindings/gpio/gpio.h>
++    #include <dt-bindings/interrupt-controller/arm-gic.h>
++    #include <dt-bindings/reset/zte,zx279128s-reset.h>
++
++    pcie@f000000 {
++        compatible = "zte,zx279128s-pcie";
++        reg = <0x0f000000 0x4000>,
++              <0x09500000 0x1000>,
++              <0x1c000000 0x200000>;
++        reg-names = "dbi", "ctrl", "config";
++        #address-cells = <3>;
++        #size-cells = <2>;
++        device_type = "pci";
++        bus-range = <0x00 0xff>;
++        ranges = <0x82000000 0 0x10000000 0x10000000 0 0x08000000>;
++        interrupts = <GIC_SPI 63 IRQ_TYPE_LEVEL_HIGH>;
++        #interrupt-cells = <1>;
++        interrupt-map-mask = <0 0 0 7>;
++        interrupt-map = <0 0 0 1 &gic GIC_SPI 63 IRQ_TYPE_LEVEL_HIGH>,
++                        <0 0 0 2 &gic GIC_SPI 63 IRQ_TYPE_LEVEL_HIGH>,
++                        <0 0 0 3 &gic GIC_SPI 63 IRQ_TYPE_LEVEL_HIGH>,
++                        <0 0 0 4 &gic GIC_SPI 63 IRQ_TYPE_LEVEL_HIGH>;
++        linux,pci-domain = <0>;
++        clocks = <&crm2 ZX279128S_CRM2_PCIE0_CLK>;
++        clock-names = "pcie";
++        resets = <&crm2 ZX279128S_CRM2_RESET_PCIE0>;
++        reset-names = "pcie";
++        phys = <&pcie0_phy>;
++        phy-names = "pcie";
++        reset-gpios = <&gpio3 5 GPIO_ACTIVE_LOW>;
++        enable-gpios = <&gpio3 7 GPIO_ACTIVE_HIGH>;
++    };
+--
+2.55.0
diff --git a/target/linux/sanechips/patches-6.18/016-PCI-dwc-Add-ZTE-ZX279128S-host-controller-driver.patch b/target/linux/sanechips/patches-6.18/016-PCI-dwc-Add-ZTE-ZX279128S-host-controller-driver.patch
