--- /dev/null
+++ b/target/linux/sanechips/patches-6.18/007-ARM-zte-Add-ZX279128S-platform-and-CPU-hotplug-suppo.patch
@@ -0,0 +1,50 @@
+From 1581837caac485821d6df312828eb28a19a9e241 Mon Sep 17 00:00:00 2001
+From: Navid Ghahremani <ghahramani.navid@gmail.com>
+Date: Mon, 12 Oct 2026 07:44:58 +0100
+Subject: [PATCH 03/24] ARM: zte: Add ZX279128S platform and CPU hotplug
+ support
+
+Support the dual Cortex-A9 platform, second-CPU startup through
+bootloader SRAM and CPU hotplug. Keep existing ZX297520V3 support
+intact.
+
+Signed-off-by: Navid Ghahremani <ghahramani.navid@gmail.com>
+---
+
+diff --git a/arch/arm/mach-zte/Kconfig b/arch/arm/mach-zte/Kconfig
+index d3b404ca48..ff3845f109 100644
+--- a/arch/arm/mach-zte/Kconfig
++++ b/arch/arm/mach-zte/Kconfig
+@@ -26,4 +26,21 @@ config SOC_ZX297520V3
+ 	  Please read Documentation/arch/arm/zte/zx297520v3.rst on how to boot
+ 	  the kernel.
+
++config SOC_ZX279128S
++	bool "zx279128s SoC"
++	default y
++	select ARM_AMBA
++	select ARM_GIC
++	select ARM_GLOBAL_TIMER
++	select CACHE_L2X0
++	select CACHE_L2X0_IO_LOCK
++	select CLKSRC_ARM_GLOBAL_TIMER_SCHED_CLOCK
++	select HAVE_ARM_SCU if SMP
++	select HAVE_ARM_TWD if SMP
++	help
++	  Support for the ZTE (Sanechips) zx279128s SoC, a dual-core
++	  Cortex-A9 with an L2C-310 cache controller, used in home gateways
++	  such as the ZTE ZXHN H3600. The second core is started through
++	  the on-chip SRAM, where the boot loader keeps it waiting.
++
+ endif
+diff --git a/arch/arm/mach-zte/Makefile b/arch/arm/mach-zte/Makefile
+index 1bfe4fddd6..72f518632e 100644
+--- a/arch/arm/mach-zte/Makefile
++++ b/arch/arm/mach-zte/Makefile
+@@ -1,2 +1,6 @@
+ # SPDX-License-Identifier: GPL-2.0-only
+ obj-$(CONFIG_SOC_ZX297520V3) += zx297520v3.o
++obj-$(CONFIG_SOC_ZX279128S) += zx279128s.o
++ifdef CONFIG_SMP
++obj-$(CONFIG_SOC_ZX279128S) += platsmp-zx279128s.o
++endif
diff --git a/target/linux/sanechips/patches-6.18/008-dt-bindings-clock-Add-ZTE-ZX279128S-CRM-clock-bindin.patch b/target/linux/sanechips/patches-6.18/008-dt-bindings-clock-Add-ZTE-ZX279128S-CRM-clock-bindin.patch
new file mode 100644
index 0000000000..930db51adb
--- /dev/null
+++ b/target/linux/sanechips/patches-6.18/008-dt-bindings-clock-Add-ZTE-ZX279128S-CRM-clock-bindin.patch
@@ -0,0 +1,255 @@
+From 9d174bac24970c929db0ec0f21d7009471604ba8 Mon Sep 17 00:00:00 2001
+From: Navid Ghahremani <ghahramani.navid@gmail.com>
+Date: Mon, 12 Oct 2026 07:45:20 +0100
+Subject: [PATCH 04/24] dt-bindings: clock: Add ZTE ZX279128S CRM clock
+ bindings
+
+Add Device Tree binding schemas for the ZTE ZX279128S clock controllers:
+topcrm, lspcrpm, and crm2. Define fixed clock lists and simple-mfd
+for child nodes inside topcrm.
+
+Signed-off-by: Navid Ghahremani <ghahramani.navid@gmail.com>
+---
+
+diff --git a/Documentation/devicetree/bindings/clock/zte,zx279128s-crm2.yaml b/Documentation/devicetree/bindings/clock/zte,zx279128s-crm2.yaml
+new file mode 100644
+index 0000000000..aa90ad15d1
+--- /dev/null
++++ b/Documentation/devicetree/bindings/clock/zte,zx279128s-crm2.yaml
+@@ -0,0 +1,48 @@
++# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
++%YAML 1.2
++---
++$id: http://devicetree.org/schemas/clock/zte,zx279128s-crm2.yaml#
++$schema: http://devicetree.org/meta-schemas/core.yaml#
++
++title: ZTE ZX279128S CRM2 clock and reset controller
++
++maintainers:
++  - Navid Ghahremani <ghahramani.navid@gmail.com>
++
++description:
++  Top CRM 2 (clock and reset module 2) provides clocks and resets for
++  PCIe controllers on the ZTE ZX279128S SoC.
++
++properties:
++  compatible:
++    oneOf:
++      - const: zte,zx279128s-crm2
++      - items:
++          - const: zte,zx279128s-crm2
++          - const: syscon
++
++  reg:
++    maxItems: 1
++
++  "#clock-cells":
++    const: 1
++
++  "#reset-cells":
++    const: 1
++
++required:
++  - compatible
++  - reg
++  - "#clock-cells"
++  - "#reset-cells"
++
++additionalProperties: false
++
++examples:
++  - |
++    clock-controller@94100000 {
++        compatible = "zte,zx279128s-crm2";
++        reg = <0x94100000 0x1000>;
++        #clock-cells = <1>;
++        #reset-cells = <1>;
++    };
+diff --git a/Documentation/devicetree/bindings/clock/zte,zx279128s-lspcrpm.yaml b/Documentation/devicetree/bindings/clock/zte,zx279128s-lspcrpm.yaml
+new file mode 100644
+index 0000000000..3448829a69
+--- /dev/null
++++ b/Documentation/devicetree/bindings/clock/zte,zx279128s-lspcrpm.yaml
+@@ -0,0 +1,101 @@
++# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
++%YAML 1.2
++---
++$id: http://devicetree.org/schemas/clock/zte,zx279128s-lspcrpm.yaml#
++$schema: http://devicetree.org/meta-schemas/core.yaml#
++
++title: ZTE ZX279128S Low Speed Peripheral Clock Modules
++
++maintainers:
++  - Stefan Dösinger <stefandoesinger@gmail.com>
++  - Navid Ghahremani <ghahramani.navid@gmail.com>
++
++description: |
++  Each of the two groups of low speed peripherals (LSP) has a peripheral clock
++  module (LSP CRPM) of its own, fed by the top CRM.
++
++properties:
++  compatible:
++    enum:
++      - zte,zx279128s-lsp0crpm
++      - zte,zx279128s-lsp1crpm
++
++  reg:
++    maxItems: 1
++
++  clocks:
++    minItems: 4
++    maxItems: 5
++
++  clock-names:
++    minItems: 4
++    maxItems: 5
++
++  '#clock-cells':
++    const: 1
++
++required:
++  - compatible
++  - reg
++  - clocks
++  - clock-names
++  - '#clock-cells'
++
++allOf:
++  - if:
++      properties:
++        compatible:
++          contains:
++            const: zte,zx279128s-lsp0crpm
++    then:
++      properties:
++        clocks:
++          items:
++            - description: register (APB) clock of the group
++            - description: 25 MHz work clock
++            - description: 32.768 kHz work clock
++            - description: 100 MHz work clock
++        clock-names:
++          items:
++            - const: pclk
++            - const: wclk25m
++            - const: wclk32k
++            - const: wclk100m
++  - if:
++      properties:
++        compatible:
++          contains:
++            const: zte,zx279128s-lsp1crpm
++    then:
++      properties:
++        clocks:
++          items:
++            - description: register (APB) clock of the group
++            - description: AXI clock of the group
++            - description: 25 MHz work clock
++            - description: 49.152 MHz work clock
++            - description: 100 MHz work clock
++        clock-names:
++          items:
++            - const: pclk
++            - const: aclk
++            - const: wclk25m
++            - const: wclk49m
++            - const: wclk100m
++
++additionalProperties: false
++
++examples:
++  - |
++    #include <dt-bindings/clock/zte,zx279128s-crm.h>
++
++    clock-controller@94400000 {
++        compatible = "zte,zx279128s-lsp0crpm";
++        reg = <0x94400000 0x1000>;
++        clocks = <&topcrm ZX279128S_TOP_LSP0_PCLK>,
++                 <&topcrm ZX279128S_TOP_LSP0_25M>,
++                 <&topcrm ZX279128S_TOP_LSP0_32K>,
++                 <&topcrm ZX279128S_TOP_LSP0_100M>;
++        clock-names = "pclk", "wclk25m", "wclk32k", "wclk100m";
++        #clock-cells = <1>;
++    };
+diff --git a/Documentation/devicetree/bindings/clock/zte,zx279128s-topcrm.yaml b/Documentation/devicetree/bindings/clock/zte,zx279128s-topcrm.yaml
+new file mode 100644
+index 0000000000..f0c6a6a02a
+--- /dev/null
++++ b/Documentation/devicetree/bindings/clock/zte,zx279128s-topcrm.yaml
+@@ -0,0 +1,75 @@
++# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
++%YAML 1.2
++---
++$id: http://devicetree.org/schemas/clock/zte,zx279128s-topcrm.yaml#
++$schema: http://devicetree.org/meta-schemas/core.yaml#
++
++title: ZTE ZX279128S Top Clock and Reset Module
++
++maintainers:
++  - Stefan Dösinger <stefandoesinger@gmail.com>
++  - Navid Ghahremani <ghahramani.navid@gmail.com>
++
++description: |
++  The top clock and reset module (CRM) of the ZTE ZX279128S holds the PLLs,
++  bus clocks, peripheral clocks and the reset controller.
++
++properties:
++  compatible:
++    items:
++      - const: zte,zx279128s-topcrm
++      - const: syscon
++      - const: simple-mfd
++
++  reg:
++    maxItems: 1
++
++  clocks:
++    items:
++      - description: 25 MHz crystal oscillator
++
++  clock-names:
++    items:
++      - const: osc
++
++  '#clock-cells':
++    const: 1
++
++  '#reset-cells':
++    const: 1
++
++  reboot:
++    type: object
++    $ref: /schemas/power/reset/syscon-reboot.yaml#
++    description: System reboot controller child node
++
++required:
++  - compatible
++  - reg
++  - clocks
++  - clock-names
++  - '#clock-cells'
++  - '#reset-cells'
++
++additionalProperties: false
++
++examples:
++  - |
++    #include <dt-bindings/clock/zte,zx279128s-crm.h>
++    #include <dt-bindings/reset/zte,zx279128s-reset.h>
++
++    topcrm: clock-controller@94000000 {
++        compatible = "zte,zx279128s-topcrm", "syscon", "simple-mfd";
++        reg = <0x94000000 0x1000>;
++        clocks = <&osc>;
++        clock-names = "osc";
++        #clock-cells = <1>;
++        #reset-cells = <1>;
++
++        reboot {
++            compatible = "syscon-reboot";
++            offset = <0x44>;
++            mask = <0x1>;
++            value = <0x1>;
++        };
++    };
diff --git a/target/linux/sanechips/patches-6.18/009-clk-zte-Add-ZX279128S-CRM-clock-and-reset-driver.patch b/target/linux/sanechips/patches-6.18/009-clk-zte-Add-ZX279128S-CRM-clock-and-reset-driver.patch
new file mode 100644
index 0000000000..eeecfa7fa0
--- /dev/null
+++ b/target/linux/sanechips/patches-6.18/009-clk-zte-Add-ZX279128S-CRM-clock-and-reset-driver.patch
@@ -0,0 +1,64 @@
+From ce494faad64a11f8792d56b23184d104531e4577 Mon Sep 17 00:00:00 2001
+From: Navid Ghahremani <ghahramani.navid@gmail.com>
+Date: Mon, 12 Oct 2026 07:46:04 +0100
+Subject: [PATCH 06/24] clk: zte: Add ZX279128S CRM clock and reset driver
+
+Support the top CRM and low-speed peripheral clock controllers of the
+ZTE ZX279128S SoC. Implement custom reset controller ops mapping
+logical reset IDs to internal hardware register offsets, and provide
+CRM2 clock gating and reset controller support for PCIe.
+
+Signed-off-by: Navid Ghahremani <ghahramani.navid@gmail.com>
+---
+
+diff --git a/drivers/clk/Kconfig b/drivers/clk/Kconfig
+index f9592fd9ec..5200de26c0 100644
+--- a/drivers/clk/Kconfig
++++ b/drivers/clk/Kconfig
+@@ -547,6 +547,7 @@ source "drivers/clk/uniphier/Kconfig"
+ source "drivers/clk/visconti/Kconfig"
+ source "drivers/clk/x86/Kconfig"
+ source "drivers/clk/xilinx/Kconfig"
++source "drivers/clk/zte/Kconfig"
+ source "drivers/clk/zynqmp/Kconfig"
+
+ # Kunit test cases
